<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_record_fi_template">
         <t t-call="web.html_container">
            <t t-call="web.external_layout">

                <div class="page">
                     <table width="20%" style="border: 0px solid white; border-collapse: collapse;" class="text-right" height="20">
                        <thead>
                            <tr  height="20px" align="center">
                                <td style="padding-left:5px;border: 1px solid black;" class="text-left">FECHA : </td>
                                <td style="padding-left:5px;border: 1px solid black;" class="text-left"><span t-esc="form_data['date_start']" t-options='{"widget": "date","format": "dd-MM-yyyy"}'/></td>
                            </tr>
                        </thead>
                     </table> 

                    <div style="color: black;" class="text-center"><h2>CONSTANCIA DE APROBACIÓN</h2></div>



					<table width="100%" style="border: none;" height="30" align="justify">
                        <thead>

                        <tr  height="20px" align="justify">
                           <td colspan='4' style="padding-left:5px;padding-right:5px;border: 1px solid black;color: black;" align="justify">
                                       La Coordinación Académica de <span t-esc="est[0]['empresa']"/>, certifica que la alumno(a)
                                    <span t-esc="est[0]['nombre']"/> titular de la cédula de identidad N° <span t-esc="est[0]['cedula']"/> 
                                    
                                    registrado(a) bajo el código: <span t-esc="est[0]['codigo']"/> aprobó de manera sastisfactoria los siguientes cursos:
                                     <br/>
                                       
                                             
                    
                                <table width="70%" height="30" align="justify" style="border: none;">
                                    <thead>
                                        
                                        <tr style="font-size: 20px;" height="30px" align="center">
                                            
                                            <th colspan="5" style="border: 1px solid black;color: black;">CURSOS</th>
                                            
                                        </tr>

                                        <tr style="font-size: 12px;" height="25px" align="center">
                                            
                                            <th   style="border: 1px solid black;color: black;">#</th>
                                        
                                            <th  style="border: 1px solid black;color: black;">NOMBRE</th>
                                            <th  style="border: 1px solid black;color: black;">SECCIÓN</th>
                                            <th  style="border: 1px solid black;color: black;">CALIFICACIÓN</th>
                                            <th  style="border: 1px solid black;color: black;">VALORACIÓN</th>
                                            
                                        </tr>
                                    </thead>
                                    <tbody>

                                        <t t-set="i" t-value="0" />
                                    
                                        <t t-foreach="cur" t-as="line">
                                            <tr style="font-size: 12px;">

                                                <t t-set="i" t-value="i+1"/>
                            
                                                <td   style="padding-right:4px;padding-left:4px;border: 1px solid black;" align="center"> <span t-esc="i" /></td>
                                                
                                                <td  style="padding-right:4px;padding-left:4px;border: 1px solid black;" class="text-left"><span t-esc="line['curso']"/></td>
                                                <td  style="padding-right:4px;padding-left:4px;border: 1px solid black;" align="center"> <span t-esc="line['seccion']" /> </td>
                                                <td  style="padding-right:4px;padding-left:4px;border: 1px solid black;" align="center"> <span t-esc="line['nota']" t-options='{"widget": "float", "precision": 2}'/> </td>
                                                <td  style="padding-right:4px;padding-left:4px;border: 1px solid black;" align="center"> <span t-esc="line['status']" /> </td>

                                            </tr>
                                        </t>
            
                                        <div>
                                            <p t-if="i == 0"><h2>NO HAY ITEMS PARA MOSTRAR</h2></p>
                                        </div>
                                    </tbody>
                                </table>

                                          pertenecientes a nuestro programa de <span t-esc="est[0]['programa']"/>.
                                          Nuestro método de aprendizaje en el idioma Inglés consta de 6 niveles:
                                          Beginner, Elementary, Pre-Inmediate, Advanced y avanced Plus.
                                    <br/>
                                    <br/>
                                    Constancia que se expide en la ciudad de Acarigua en fecha :  <span t-esc="form_data['date_start']" t-options='{"widget": "date","format": "dd-MM-yyyy"}'/> 
                                    <br/> 
                                    Atentamente,
                                    <br/>
                                    <br/>
                                    <br/>

                                <br/>

                            </td>


                            </tr>
                            <tr align="center">
                                <td>
                                    <t t-set="signer_id" t-value="env['cei.signer'].sudo().search([('id', '=', signer)])"/>
                                    <img t-if="signer_id.sign_signature" t-att-src="image_data_uri(signer_id.sign_signature)" align="center" style="max-width: 250px; max-height: 200px; display: block; position: relative; top: 30px;" alt="Logo"/>                                    
                                    ---------------------------------------
                                    <br/>
                                    <strong t-esc="signer_id.name"/> <span t-if="signer_id.job_title">-</span> <strong t-if="signer_id.job_title" t-esc="signer_id.job_title"/> 
                                    <br/>
                                    <br/>
                                </td>
                            </tr>
                             

                        </thead>
                        
                    </table>




      

                </div>
            </t>
        </t>
    </template>

    <record id="action_report_record_fi" model="ir.actions.report">
        <field name="name">Constancia de Finalización</field>
        <field name="model">school.student</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">report_class.report_record_fi_template</field>
        <field name="report_file">report_class.report_record_fi_template</field>
        <field name="binding_type">report</field>
    </record>
    
</odoo>