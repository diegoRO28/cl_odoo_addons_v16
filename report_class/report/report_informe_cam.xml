<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_informe_cam">
         <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="oe_structure" />
                <div class="page">
                     <table width="20%" style="border: 0px solid white; border-collapse: collapse;" class="text-right" height="20">
                        <thead>
                            <tr  height="20px" align="center">
                                <td style="padding-left:5px;border: 1px solid black;" class="text-left">FECHA : </td>
                                <td style="padding-left:5px;border: 1px solid black;" class="text-left"><span t-esc="form_data['date_today']" t-options='{"widget": "date","format": "dd-MM-yyyy"}'/></td>
                               
                            </tr>
                        </thead>
                     </table> 

                    <div style="border: 1px solid black;color: white;" class="text-center"><h2>INFORME DE CAMBIOS</h2></div>
                    <table width="100%" style="border: 0px solid white; border-collapse: collapse;" height="20">
                        <thead>
                            
                            <tr  style="background-color: #c3ccb8; font-size: 12px;" height="20px" align="center">
                                 <td style="padding-left:5px;border: 1px solid black;" class="text-left">DEL : </td>
                                 <td style="padding-left:5px;border: 1px solid black;" class="text-left"><strong t-esc="form_data['date_start']" t-options='{"widget": "date","format": "dd-MM-yyyy"}'/></td>
                                 <td style="padding-left:5px;border: 1px solid black;" class="text-left"> / </td>
                                 <td style="padding-left:5px;border: 1px solid black;" class="text-left">AL : </td>
                                 <td style="padding-left:5px;border: 1px solid black;" class="text-left"><strong t-esc="form_data['date_end']" t-options='{"widget": "date","format": "dd-MM-yyyy"}'/></td>
                            </tr>
                        </thead>
                    </table> 

                    <table width="100%" style="border: 1px solid black; border-collapse: collapse;" height="30">
                        <thead>

                             <tr style="background-color: #ACD180; font-size: 12px;" height="30px" align="center">
                                  
                                <th  style="border: 1px solid black;color: white;">#</th>
                                <th  style="border: 1px solid black;color: white;">FECHA           </th>
                                
                                <th  colspan="2" style="border: 1px solid black;color: white;">ESTUDIANTE      </th>
                                <th  colspan="2" style="border: 1px solid black;color: white;">SECCION ORIGEN  </th>
                                <th  colspan="2" style="border: 1px solid black;color: white;">SECCIÓN DESTINO </th>
                                
                             </tr>
                        </thead>
                        <tbody>

                            <t t-set="i" t-value="0" />
                           
                            <t t-foreach="asi" t-as="line">
                                <tr style="font-size: 12px;">

                                    <t t-set="i" t-value="i+1"/>
                
                                    <td  style="padding-right:4px;padding-left:4px;border: 1px solid black;" align="center">   <span t-esc="i" /></td>
                                    <td  style="padding-right:4px;padding-left:4px;border: 1px solid black;" align="center">   <span t-esc="line['fechaCam']" t-options='{"widget": "date","format": "dd-MM-yyyy"}'/>  </td>
                                    <td  style="padding-right:4px;padding-left:4px;border: 1px solid black;" class="text-left"><strong t-esc="line['codeStu']"/>  </td>
                                    <td  style="padding-right:4px;padding-left:4px;border: 1px solid black;" class="text-left"><span t-esc="line['nombreStu']"/>  </td>

                                    <td  style="padding-right:4px;padding-left:4px;border: 1px solid black;" align="left">     <span t-esc="line['nombreCam']" /> </td>
                                    <td  style="padding-right:4px;padding-left:4px;border: 1px solid black;" align="left">     <span t-esc="line['nombreSec']" /> </td>
 
                                    <td  style="padding-right:4px;padding-left:4px;border: 1px solid black;" align="left">     <span t-esc="line['nombreCamDes']" /> </td>
                                    <td  style="padding-right:4px;padding-left:4px;border: 1px solid black;" align="left">     <span t-esc="line['nombreSecDes']" /> </td>
                             
                                </tr>
                            </t>
                           
                            <div>
                                <p t-if="i == 0"><h2>NO HAY ITEMS PARA MOSTRAR</h2></p>
                            </div>
                        </tbody>
                    </table>

                </div>
            </t>
        </t>
    </template>

    <record id="action_report_informe_cam" model="ir.actions.report">
        <field name="name">Cambios</field>
        <field name="model">school.student</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">report_class.report_informe_cam</field>
        <field name="report_file">report_class.report_informe_cam</field>
        <field name="binding_type">report</field>
    </record>
    
</odoo>