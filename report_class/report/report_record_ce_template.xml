<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_record_ce_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="oe_structure" />
                <div class="page">
                     
                    <div style="color:black;" class="text-center"><h2>CONSTANCIA</h2></div>

					<table width="100%" style="padding-left:5px; padding-right:5px; border: 0px solid white; color: black;" height="30" align="justify">
                        <thead>
                            <tr height="20px" align="justify">
                                <td colspan='4' style="padding-left:5px;padding-right:5px;border: 0px solid white;color: black;" align="justify">
                                    <t t-if="est and len(est) > 0">
                                        <br/>
                                        <br/>
                                        La Coordinación Académica de <strong t-esc="est[0].get('empresa', '')"/>, certifica que la alumno(a)
                                        <strong t-esc="est[0].get('nombre', '')"/> titular de la cédula de identidad N° <strong t-esc="est[0].get('cedula', '')"/> 
                                        
                                        registrado(a) bajo el código: <strong t-esc="est[0].get('codigo', '')"/> se encuentra cursando el nivel <strong t-esc="est[0].get('curso', '')"/>
                                        de nuestro programa de <strong t-esc="est[0].get('programa', '')"/>
                                        asistiendo en el horario: <strong t-esc="est[0].get('schedule', '')"/>. Nuestro método de aprendizaje en el idioma Inglés consta de 6 niveles:
                                        Beginner, Elementary, Pre-Inmediate, Advanced y avanced Plus.
                                        <br/>
                                        <br/>
                                        Constancia que se expide en la ciudad de Acarigua <strong t-esc="est[0].get('date', '')" />. 
                                        <br/> 
                                        Atentamente,
                                        <br/>
                                        <br/>
                                        <br/>
                                    </t>
                                    <t t-if="not est or len(est) == 0">
                                        <strong style="color: red;">No se encontraron datos del estudiante. Verifique que la sección no esté archivada.</strong>
                                        <br/><br/>
                                    </t>
                                </td>
                            </tr>
                            <tr align="center">
                                <td>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <t t-set="signer_id" t-value="env['cei.signer'].sudo().with_context(active_test=False).search([('id', '=', signer)])"/>
                                    <t t-if="signer_id and signer_id.sign_signature">
                                        <img t-att-src="image_data_uri(signer_id.sign_signature)" align="center" style="max-width: 250px; max-height: 200px; display: block; position: relative; top: 30px;" alt="Logo"/>
                                    </t>
                                    <t t-else="">
                                        <div style="height: 50px;"></div>
                                    </t-else>
                                    ---------------------------------------
                                    <br/>
                                    <t t-if="signer_id and signer_id.name">
                                        <strong t-esc="signer_id.name"/>
                                    </t>
                                    <t t-if="signer_id and signer_id.job_title">
                                        <span> - </span>
                                        <strong t-esc="signer_id.job_title"/>
                                    </t>
                                    <br/>
                                    <br/>
                                </td>
                            </tr>
                        </thead>
                    </table> 
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_record_ce" model="ir.actions.report">
        <field name="name">Constancia de Estudios</field>
        <field name="model">school.student</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">report_class.report_record_ce_template</field>
        <field name="report_file">report_class.report_record_ce_template</field>
        <field name="binding_type">report</field>
    </record>
    
</odoo>