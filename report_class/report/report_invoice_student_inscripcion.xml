<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="student_invoice_inscripcion_report_temp_formate">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="oe_structure" />
                    

                    <div class="page">
                            
                        <div style="color:black;" class="text-center"><h3>FACTURAS POR INSCRIPCIÓN</h3></div>        

                        <table width="100%"  style="padding-left:5px; padding-right:5px; border: 1px solid black; color: black;font-size: 12px;" height="30" >
                                    <thead >
                                            <tr height="25px" style="padding-top:5px; ">
                                                <th style="font-family: 'Helvetica';font-size: 10px;padding-left:5px;" align="left">#</th>
                                                <th style="font-family: 'Helvetica';font-size: 10px;padding-left:5px;" align="center">FECHA</th>
                                                <th style="font-family: 'Helvetica';font-size: 10px;padding-left:5px;" align="center">FACTURA</th>
                                                <th style="font-family: 'Helvetica';font-size: 10px;padding-left:5px;" align="center">ESTUDIANTE</th>
                                                <th style="font-family: 'Helvetica';font-size: 10px;padding-left:5px;" align="center">CÓDIGO</th>
                                                <th style="font-family: 'Helvetica';font-size: 10px;padding-left:5px;" align="center">CURSO</th>
                                                <th style="font-family: 'Helvetica';font-size: 10px;padding-left:5px;" align="center">MONTO</th>
                                                <th style="font-family: 'Helvetica';font-size: 10px;padding-left:5px;" align="center">PAGO</th>
                                                <th style="font-family: 'Helvetica';font-size: 10px;padding-left:5px;" align="center">DEUDA</th>
                                            </tr>
                                    </thead>

                                    <t t-set="i" t-value="0"/>
                                    <t t-set="pago" t-value="0"/>
                                    <t t-set="acumVenta" t-value="0"/>
                                    <t t-set="acumPago" t-value="0"/>
                                    <t t-set="acumDeuda" t-value="0"/>

                                    <t t-foreach="docs" t-as="o">

                                        <t t-set="pago" t-value="0"/>
                                        <t t-set="i" t-value="i+1"/>
                                        <t t-set="pago" t-value="o.amount_total-o.amount_residual"/>

                                        <t t-set="acumVenta" t-value="acumVenta + o.amount_total"/>
                                        <t t-set="acumPago" t-value="acumPago + pago"/>
                                        <t t-set="acumDeuda" t-value="acumDeuda + o.amount_residual"/>

                                        <tr  height="20px" >

                                            <td style="font-family: 'Helvetica';padding-left:5px;padding-right:5px;" align="right"> 
                                                <span t-esc="i" />
                                            </td>
    
                                            <td style="font-family: 'Helvetica';padding-left:5px;">
                                                <span t-field="o.invoice_date"/>
                                            </td>
                                            <td style="font-family: 'Helvetica';padding-left:5px;" >
                                                <strong t-field="o.name" />
                                            </td>
                              
                                            <td style="font-family: 'Helvetica';padding-left:5px;" align="left">
                                                <span t-field="o.partner_id.student_id"/>
                                            </td>
                                             
                                            <td style="font-family: 'Helvetica';padding-left:5px;padding-right:5px;" >
                                                <strong t-field="o.partner_id.student_code"/>
                                            </td>
                                                                                   
                                            <t t-foreach="o.invoice_line_ids" t-as="line" align="left">
                                                <td style="font-family: 'Helvetica';padding-left:5px;">
                                                    <span t-esc="line.name"/>
                                                </td>
                                            </t>
                                            <td style="font-family: 'Helvetica';padding-left:5px;padding-right:5px;" align="right">
                                                <strong t-field="o.amount_total" />
                                            </td>
                                            <td style="font-family: 'Helvetica';padding-left:5px;padding-right:5px;" align="right">
                                                <span t-esc="pago" />
                                            </td>
                                            <td style="font-family: 'Helvetica';padding-left:5px;padding-right:5px;" align="right">
                                                <strong t-field="o.amount_residual" />
                                            </td> 
                                        </tr>
                                            
                                    </t>
                                <tr height="30px" style="font-size: 14px;" > 
                                    <td style="padding-right:4px;border: 1px solid black;background-color: #f5f5f5;" class="text-center"> <strong t-esc="i" t-options='{"widget": "float", "precision": 0}'/> </td>
                                    <td colspan="5" style="padding-right:4px;border: 1px solid black;background-color: #f5f5f5;" class="text-center"> TOTALES <strong/> </td>
                                     <td style="padding-right:4px;border: 1px solid black;background-color: #f5f5f5;" align="right"> <strong t-esc="acumVenta" t-options='{"widget": "float", "precision": 2}'/> </td>

                                    <td  style="padding-right:4px;border: 1px solid black;background-color: #f5f5f5;" align="right"> <strong t-esc="acumPago" t-options='{"widget": "float", "precision": 2}'/> </td>
                                    <td  style="padding-right:4px;border: 1px solid black;background-color: #f5f5f5;" align="right"> <strong t-esc="acumDeuda" t-options='{"widget": "float", "precision": 2}'/> </td>
                        
                                </tr>
                                                        
                            <div>
                                <p t-if="i == 0"><h2>NO HAY ITEMS PARA MOSTRAR</h2></p>
                            </div>
                       </table> 
                         
                    </div>
                </t>
            </t>
            
        </template>
    </data>
</odoo>
