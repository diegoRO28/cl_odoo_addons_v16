<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_record_template">
         <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="oe_structure" />
                <div class="page">
                     <table width="20%" style="border: 0px solid white; border-collapse: collapse;" class="text-right" height="20">
                        <thead>
                            <tr  height="20px" align="center">
                                <td style="padding-left:5px;border: 1px solid black;" class="text-left">FECHA : </td>
                                <td style="padding-left:5px;border: 1px solid black;" class="text-left"><span t-esc="form_data['date_start']" t-options='{"widget": "date","format": "dd-MM-yyyy"}'/></td>
                               
                            </tr>
                        </thead>
                     </table> 

                    <div style="background-color: #b3b2b1; color: white;" class="text-center"><h2>RECORD ACADÉMICO</h2></div>

					<table width="100%" style="border: 1px solid black; border-collapse: collapse;" height="30">
                        <thead>
                            <tr  height="20px" align="center">
                                <td style="padding-left:5px;border: 1px solid black;background-color: #b3b2b1;color: black;" align="left">NOMBRE</td>
                                <td style="padding-left:5px;border: 1px solid black;" align="left"> <span t-esc="est[0]['nombre']"/> </td> 
                                <td style="padding-left:5px;border: 1px solid black;background-color: #b3b2b1;color: black;" align="left">SECCIÓN</td>
                                <td style="padding-left:5px;border: 1px solid black;" align="left"> <span t-esc="est[0]['seccion']"/> </td>

                            </tr>

                            <tr  height="20px" align="center">
                                <td style="padding-left:5px;border: 1px solid black;background-color: #b3b2b1;color: black;" align="left">CÓDIGO</td>
                                
                                <td style="padding-left:5px;border: 1px solid black;" align="left"> <span t-esc="est[0]['codigo']"/> </td>
                                <td style="padding-left:5px;border: 1px solid black;background-color: #b3b2b1;color: black;" align="left">CURSO</td>
                                <td style="padding-left:5px;border: 1px solid black;" align="left"><span t-esc="est[0]['curso']"/></td>
                                
                            </tr>

                            <tr  height="20px" align="center">
                                <td style="padding-left:5px;border: 1px solid black;background-color: #b3b2b1;color: black;" align="left">IDENTIFICACIÓN</td>
                                
                                <td style="padding-left:5px;border: 1px solid black;" align="left"> <span t-esc="est[0]['cedula']"/> </td>
                          
                                <td style="padding-left:5px;border: 1px solid black;background-color: #b3b2b1;color: black;" align="left">STATUS</td>
                                <td style="padding-left:5px;border: 1px solid black;" align="left"><span t-esc="est[0]['estado']"/></td>
                                
                            </tr>
                        </thead>
                    </table> 
                    
                    
                    <table width="100%" style="border: 1px solid black; border-collapse: collapse;" height="30">
                        <thead>
                            
                            <tr style="background-color: #5AA302; font-size: 20px;" height="30px" align="center">
                                  
                                <th colspan="5" style="border: 1px solid black;color: white;">REGISTRO DE ASISTENCIAS</th>
                                
                            </tr>

                             <tr style="background-color: #ACD180; font-size: 12px;" height="30px" align="center">
                                  
                                <th   style="border: 1px solid black;color: white;">#</th>
                               
                                <th  style="border: 1px solid black;color: white;">ENCUENTRO</th>
                                <th  style="border: 1px solid black;color: white;">DESCRIPCIÓN</th>
                                <th  style="border: 1px solid black;color: white;">ASISTENCIA</th>
                                <th  style="border: 1px solid black;color: white;">STATUS</th>
                                
                                
                             </tr>
                        </thead>
                        <tbody>

                            <t t-set="i" t-value="0" />
                           
                            <t t-foreach="asi" t-as="line">
                                <tr style="font-size: 12px;">

                                    <t t-set="i" t-value="i+1"/>
                
                                    <td   style="padding-right:4px;padding-left:4px;border: 1px solid black;" align="center"> <span t-esc="i" /></td>
                                    
                                    <td  style="padding-right:4px;padding-left:4px;border: 1px solid black;" class="text-left"><span t-esc="line['encuentro_nombre']"/></td>
                                    
                                    <td  style="padding-right:4px;padding-left:4px;border: 1px solid black;" class="text-left"><span t-esc="line['descripcion']"/></td>
                                    
                                    <td  style="padding-right:4px;padding-left:4px;border: 1px solid black;" align="center"> <span t-esc="line['is_asistio']" /> </td>
                                    
                                    <td  style="padding-right:4px;padding-left:4px;border: 1px solid black;" align="center"> <span t-esc="line['nombreSta']" /> </td>
                                </tr>
                            </t>
                           
                            

                            <div>
                                <p t-if="i == 0"><h2>NO HAY ITEMS PARA MOSTRAR</h2></p>
                            </div>
                        </tbody>
                    </table>

                    <table width="100%" style="border: 1px solid black; border-collapse: collapse;" height="30">
                        <thead>
                            <tr style="background-color: #5AA302; font-size: 20px;" height="30px" align="center">
                                  
                                <th colspan="9" style="border: 1px solid black;color: white;">REGISTRO DE EVALUACIONES</th>
                                
                            </tr>
                            <tr style="background-color: #ACD180; font-size: 12px;" height="30px" align="center">
                                  
                                <th width="2%"  style="border: 1px solid black;color: white;">#</th>
                               
                                <th width="50" style="border: 1px solid black;color: white;">EVALUACIÒN / ACTIVIDAD  </th>
                                <th width="20%" style="border: 1px solid black;color: white;">CALIFICACIÓN        </th>
                                
                                <th width="2%" style="border: 1px solid black;color: white;">RECUPERACIÓN        </th>
                                <th width="10%" style="border: 1px solid black;color: white;">STATUS              </th>
                                
                                
                             </tr>
                        </thead>
                        <tbody>

                            <t t-set="i" t-value="0" />
                           

                            <t t-foreach="eva" t-as="line">
                                <tr style="background-color: #9eb384; font-size: 18px;" height="30px" >

                                    <t t-set="i" t-value="i+1"/>
                
                                    <td width="2%"  style="padding-right:4px;padding-left:4px;border: 1px solid black;" align="center"> <span t-esc="i" /></td>
                                    
                                    <td width="50%" style="padding-right:4px;padding-left:4px;border: 1px solid black;" class="text-left"><strong t-esc="line['nombreEva']"/></td>
                                    <td width="20%" style="padding-right:4px;padding-left:4px;border: 1px solid black;" align="letf"> <strong t-esc="line['nota']"  t-options='{"widget": "float", "precision": 2}' /> </td>
                                    <td width="10%"  style="padding-right:4px;padding-left:4px;border: 1px solid black;" align="center"> </td>
                                    <td width="10%" style="padding-right:4px;padding-left:4px;border: 1px solid black;" align="center"><strong t-esc="line['nombreSta']"/></td>
                               
                                </tr>

                                <t t-set="j" t-value="0" />
                                <t t-foreach="line['listAct']" t-as="lineA">
                                    <tr style="font-size: 12px;">

                                        <t t-set="j" t-value="j+1"/>
                    
                                        <!-- <td width="2%"  style="padding-right:4px;padding-left:4px;border: 1px solid black;" align="center"> <span t-esc="j" /></td> -->
                                        <td width="10%"  style="padding-right:4px;padding-left:4px;border: 1px solid black;" align="center"> </td>
                                        <td width="50%" style="padding-right:4px;padding-left:10px;border: 1px solid black;" align="text-left"><span t-esc="lineA['nombreAct']"/></td>
                                        <td width="20%" style="padding-right:4px;padding-left:4px;border: 1px solid black;" align="right"> <span t-esc="lineA['nota']"   t-options='{"widget": "float", "precision": 2}' /> </td>
                    
                                        <t t-if="lineA['nota_r'] == 0">
                                            <td width="10%"  style="padding-right:4px;padding-left:4px;border: 1px solid black;" align="center"> </td>
                                        </t>
                                        <t t-else="">
                                            <td width="2%" style="padding-right:4px;padding-left:4px;border: 1px solid black;" align="center"> <span t-esc="lineA['nota_r']" t-options='{"widget": "float", "precision": 0}' /></td>
                                        </t>

                                        <td width="10%"  style="padding-right:4px;padding-left:4px;border: 1px solid black;" align="center"> </td>
                                        
                                    </tr>
                                </t> 
 
                            </t>
 
                           
                            <tr style="background-color: #5AA302; font-size: 20px;" height="30px" align="center"> 
                                    <th colspan="9" class="text-center" style="border: 1px solid black;color: white;">RESULTADOS / PROMEDIOS</th>
                            </tr>

                            <tr style="background-color: #ACD180; font-size: 12px;" height="30px" align="center">
                                    
                                <th width="10%" style="border: 1px solid black;color: white;">% ASISTENCIA</th>
                                <th width="10%" style="border: 1px solid black;color: white;">CALIFICACIÓN / PROMEDIO</th>
                                <th colspan="5" style="border: 1px solid black;color: white;">VALORACIÓN</th>
                                
                             </tr>

                            <tr height="30px" style="font-size: 18px;" > 
                                    <td style="padding-right:4px;border: 1px solid black;background-color: #f5f5f5;" class="text-center"> <strong t-esc="pro[0]['promeA']" t-options='{"widget": "float", "precision": 2}'/> </td>
                                    <td style="padding-right:4px;border: 1px solid black;background-color: #f5f5f5;" class="text-center"> <strong t-esc="pro[0]['promeT']" t-options='{"widget": "float", "precision": 2}'/> </td>
                                    <td colspan="5" style="padding-right:4px;border: 1px solid black;background-color: #f5f5f5;" class="text-center"> <strong t-esc="pro[0]['nombreSta']" /> </td>
                            </tr>
                                                        
                            <div>
                                <p t-if="i == 0"><h2>NO HAY ITEMS PARA MOSTRAR</h2></p>
                            </div>
                        </tbody>
                    </table>

                  

                </div>
            </t>
        </t>
    </template>

    <record id="action_report_record" model="ir.actions.report">
        <field name="name">Record</field>
        <field name="model">school.student</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">report_class.report_record_template</field>
        <field name="report_file">report_class.report_record_template</field>
        <field name="binding_type">report</field>
    </record>
    
</odoo>