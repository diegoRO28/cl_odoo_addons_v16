<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Definición del Wizard -->
    <record id="report_wizard_as_view_form" model="ir.ui.view">
        <field name="name">report.wizard_as.view.form</field>
        <field name="model">report.wizard_as</field>
        <field name="arch" type="xml">
            <form string="Informe de Inasistencias">
                <sheet> 
                    <group>
                        <field name="date_today" invisible="1"/>
                    </group>
                   
                    <separator string="SELECCIONE LA FECHA DE INICIO" colspan="2" />
                    <group>
                        <field name="date_start" />
                    </group>

                    <separator string="SELECCIONE LA FECHA FIN" colspan="2" />
                    <group>
                        <field name="date_end"  widget="date" />
                    </group>

                    <separator string="SELECCIONE LA SECCIÓN" colspan="2" />
                    <group>
                        <field name="section_id" context="{'active_test': False}"/>
                    </group>

                    <separator string="SELECCIONE EL TIPO DE REPORTE" colspan="2" />
                    <group>
                        <field name="report_type" />
                    </group>

                    <footer>
                        <button name="action_search_salida" type="object" string="Generar Informe" class="btn-primary" />
                        <button string="Cancelar" class="btn-secondary" special="cancel" />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Definición de la acción -->
    <record id="report_wizard_as_action" model="ir.actions.act_window">
        <field name="name">Generar Informe de Inasistencias</field>
        <field name="res_model">report.wizard_as</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="report_wizard_as_view_form" />
        <field name="target">new</field>
    </record>
	
	<!-- Definición del menú -->
    <menuitem
        id="report_menu_info"
        name="Informes"
        groups="school.group_school_administration"
        parent="school.menu_ems"
        sequence="117" />

        <menuitem id="menu_asistencia" 
                name='Asistencias'
              parent="report_menu_info" 
            sequence="1" />

        <menuitem
                  id="informe_ina_action"
                name="Listado de Inasistencias"
              action="report_wizard_as_action"
              parent="menu_asistencia"
            sequence="1" />

</odoo>