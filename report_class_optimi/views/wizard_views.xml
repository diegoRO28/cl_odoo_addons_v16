<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================== -->
    <!-- SOLO LAS VISTAS QUE SON ESTRICTAMENTE NECESARIAS -->
    <!-- =========================================== -->

    <!-- Solo heredamos las vistas existentes para añadir el contexto active_test=False -->
    <record id="report_class.report_wizard_view_form" model="ir.ui.view">
        <field name="name">report.wizard.view.form (optimized)</field>
        <field name="model">report.wizard</field>
        <field name="inherit_id" ref="report_class.report_wizard_view_form"/>
        <field name="arch" type="xml">
            <field name="student_id" position="attributes">
                <attribute name="context">{'active_test': False}</attribute>
            </field>
            <field name="inscripcion_id" position="attributes">
                <attribute name="context">{'active_test': False}</attribute>
            </field>
        </field>
    </record>

