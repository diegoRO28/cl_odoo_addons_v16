<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================== -->
    <!-- VISTAS OPTIMIZADAS (REEMPLAZAN LAS ORIGINALES) -->
    <!-- =========================================== -->

    <!-- Record Académico Optimizado -->
    <record id="report_wizard_optimized_view_form" model="ir.ui.view">
        <field name="name">report.wizard.optimized.view.form</field>
        <field name="model">report.wizard.optimized</field>
        <field name="arch" type="xml">
            <form string="Record Académico Optimizado">
                <sheet>
                    <group col="2">
                        <group string="SELECCIONE EL ESTUDIANTE">
                            <field name="student_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}" 
                                   context="{'active_test': False}"/>
                        </group>
                        <group string="SELECCIONE LA SECCIÓN">
                            <field name="inscripcion_id" domain="[('student_id','=', student_id)]" widget="selection"
                                   context="{'active_test': False}"/>
                        </group>
                    </group>

                    <separator string="INFORMACIÓN DE LA SECCIÓN" colspan="2" />
                    <group col="2">
                        <group>
                            <field name="standard_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                            <field name="school_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                            <field name="subject_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="start_date" />
                            <field name="end_date" />
                            <field name="state_sec" decoration-warning="state_sec =='por iniciar'"
                                                    decoration-success="state_sec =='iniciado'"
                                                    decoration-info="state_sec =='culminado'"
                                                    widget="badge"/>
                        </group>
                    </group>

                    <footer>
                        <button name="action_search_salida" type="object" string="Generar Record" class="btn-primary" />
                        <button string="Cancelar" class="btn-secondary" special="cancel" />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción para el Record Académico Optimizado -->
    <record id="report_wizard_optimized_action" model="ir.actions.act_window">
        <field name="name">Record Académico (Optimizado)</field>
        <field name="res_model">report.wizard.optimized</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="report_wizard_optimized_view_form" />
        <field name="target">new</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <!-- =========================================== -->
    <!-- CONSTANCIA DE ESTUDIOS OPTIMIZADA -->
    <!-- =========================================== -->

    <record id="report_wizard_ce_optimized_view_form" model="ir.ui.view">
        <field name="name">report.wizard.ce.optimized.view.form</field>
        <field name="model">report.wizard.ce.optimized</field>
        <field name="arch" type="xml">
            <form string="Constancia de Estudios Optimizada">
                <sheet>
                    <separator string="SELECCIONE EL ESTUDIANTE" colspan="2" />
                    <group>
                        <field name="student_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}"
                               context="{'active_test': False}"/>
                    </group>

                    <separator string="SELECCIONE LA SECCIÓN" colspan="2" />
                    <group>
                        <field name="inscripcion_id" domain="[('student_id','=', student_id)]" widget="selection"
                               context="{'active_test': False}"/>
                    </group>

                    <separator string="SELECCIONE EL FIRMANTE" colspan="2" />
                    <group>
                        <field name="signer_id" required="1" 
                               options="{'no_edit': True, 'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"
                               context="{'active_test': False}"/>
                    </group>

                    <footer>
                        <button name="action_search_salida" type="object" string="Generar Constancia" class="btn-primary" />
                        <button string="Cancelar" class="btn-secondary" special="cancel" />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="report_wizard_ce_optimized_action" model="ir.actions.act_window">
        <field name="name">Constancia de Estudios (Optimizada)</field>
        <field name="res_model">report.wizard.ce.optimized</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="report_wizard_ce_optimized_view_form" />
        <field name="target">new</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <!-- =========================================== -->
    <!-- CONSTANCIA DE FINALIZACIÓN OPTIMIZADA -->
    <!-- =========================================== -->

    <record id="report_wizard_fi_optimized_view_form" model="ir.ui.view">
        <field name="name">report.wizard.fi.optimized.view.form</field>
        <field name="model">report.wizard.fi.optimized</field>
        <field name="arch" type="xml">
            <form string="Constancia de Finalización Optimizada">
                <sheet>
                    <separator string="SELECCIONE EL ESTUDIANTE" colspan="2" />
                    <group>
                        <field name="student_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}"
                               context="{'active_test': False}"/>
                    </group>

                    <separator string="SELECCIONE EL FIRMANTE" colspan="2" />
                    <group>
                        <field name="signer_id" required="1"
                               options="{'no_edit': True, 'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"
                               context="{'active_test': False}"/>
                    </group>

                    <footer>
                        <button name="action_search_salida" type="object" string="Generar Constancia" class="btn-primary" />
                        <button string="Cancelar" class="btn-secondary" special="cancel" />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="report_wizard_fi_optimized_action" model="ir.actions.act_window">
        <field name="name">Constancia de Finalización (Optimizada)</field>
        <field name="res_model">report.wizard.fi.optimized</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="report_wizard_fi_optimized_view_form" />
        <field name="target">new</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <!-- =========================================== -->
    <!-- CONSTANCIA DE PRESENTACIÓN OPTIMIZADA -->
    <!-- =========================================== -->

    <record id="report_wizard_pr_optimized_view_form" model="ir.ui.view">
        <field name="name">report.wizard.pr.optimized.view.form</field>
        <field name="model">report.wizard.pr.optimized</field>
        <field name="arch" type="xml">
            <form string="Constancia de Presentación Optimizada">
                <sheet>
                    <separator string="SELECCIONE EL ESTUDIANTE" colspan="2" />
                    <group>
                        <field name="student_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}"
                               context="{'active_test': False}"/>
                    </group>

                    <separator string="SELECCIONE LA SECCIÓN" colspan="2" />
                    <group>
                        <field name="inscripcion_id" domain="[('student_id','=', student_id)]" widget="selection"
                               context="{'active_test': False}"/>
                    </group>

                    <separator string="SELECCIONE LA FECHA DE PRESENTACIÓN" colspan="2" />
                    <group>
                        <field name="date_end" widget="Datetime"/>
                    </group>

                    <separator string="SELECCIONE EL FIRMANTE" colspan="2" />
                    <group>
                        <field name="signer_id" required="1"
                               options="{'no_edit': True, 'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"
                               context="{'active_test': False}"/>
                    </group>

                    <footer>
                        <button name="action_search_salida" type="object" string="Generar Constancia" class="btn-primary" />
                        <button string="Cancelar" class="btn-secondary" special="cancel" />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="report_wizard_pr_optimized_action" model="ir.actions.act_window">
        <field name="name">Constancia de Presentación (Optimizada)</field>
        <field name="res_model">report.wizard.pr.optimized</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="report_wizard_pr_optimized_view_form" />
        <field name="target">new</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <!-- =========================================== -->
    <!-- MENÚS PARA ACCEDER A LOS REPORTES OPTIMIZADOS -->
    <!-- =========================================== -->

    <menuitem id="report_menu_docu_optimized"
              name="Documentos Optimizados"
              groups="school.group_school_administration,school.group_school_teacher"
              parent="school.menu_ems"
              sequence="118" />

    <menuitem id="menu_boletin_optimized"
              name="Records Optimizados"
              parent="report_menu_docu_optimized"
              sequence="1" />

    <menuitem id="boletin_optimized"
              name="Académico (Con Archivados)"
              action="report_wizard_optimized_action"
              parent="menu_boletin_optimized"
              sequence="1" />

    <menuitem id="menu_constancia_optimized"
              name="Constancias Optimizadas"
              parent="report_menu_docu_optimized"
              sequence="2" />

    <menuitem id="constancia_estudio_optimized"
              name="Estudios (Con Archivados)"
              action="report_wizard_ce_optimized_action"
              parent="menu_constancia_optimized"
              sequence="1" />

    <menuitem id="constancia_finaliza_optimized"
              name="Finalización (Con Archivados)"
              action="report_wizard_fi_optimized_action"
              parent="menu_constancia_optimized"
              sequence="2" />

    <menuitem id="constancia_presenta_optimized"
              name="Presentación (Con Archivados)"
              action="report_wizard_pr_optimized_action"
              parent="menu_constancia_optimized"
              sequence="3" />

</odoo>