<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <template id="identity_card_asi">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="height: 1px;">
                        <div class="oe_structure"/>
                        <t t-foreach="o" t-as="asi">

                        
                            <table width="100%" style="border: 1px solid white;" align="center">
                                <tr>
                                    <td  align="center" style="font-family: 'Helvetica';font-size: 24px;padding-left:5px;">
                                        <strong>
                                            FICHA DE ASISTENCIA
                                        </strong>
                                    </td>
                                    <td  align="right" style="font-family: 'Helvetica';font-size: 24px;padding-left:5px;">
                                        <strong>
                                            <span t-field="asi.name"/>
                                        </strong>
                                    </td>
                                </tr>
                            </table>

                            <table CELLPADDING="0" CELLSPACING="0" width="100%" name="encabezado" style="border: 1px solid black; font-size:13px;font-family:Arial;">
        
                                
                                <tr style="margin-top:3px">
                                    <td colspan="2" align="center" style="font-family: 'Helvetica';font-size: 20px;padding-left:5px;">
                                        <strong>
                                            <span t-field="asi.standard_id"/>
                                        </strong>
                                    </td>
                                </tr>


                                            <tr>
                                                <td  colspan="1" style="font-family: 'Helvetica';padding-left:5px;">
                                                    <strong>Encuentro</strong>
                                                </td>
                                                
                                                <td  colspan="1" style="font-family: 'Helvetica';padding-left:5px;">
                                                    <span t-field="asi.encuentro_id" />
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="font-family: 'Helvetica';padding-left:5px;">
                                                    <strong>Campus</strong>
                                                </td>
                                                
                                                <td style="font-family: 'Helvetica';padding-left:5px;">
                                                    <span t-field="asi.standard_id.school_id" />
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="font-family: 'Helvetica';padding-left:5px;">
                                                    <strong>Curso</strong>
                                                </td>
                                                
                                                <td style="font-family: 'Helvetica';padding-left:5px;">
                                                    <span t-field="asi.subject_id" />
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="font-family: 'Helvetica';padding-left:5px;">
                                                    <strong>Profesor</strong>
                                                </td>
                                                
                                                <td style="font-family: 'Helvetica';padding-left:5px;">
                                                    <span t-field="asi.teacher_id" />
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="font-family: 'Helvetica';padding-left:5px;">
                                                    <strong>Fecha</strong>
                                                </td>
                                                
                                                <td style="font-family: 'Helvetica';padding-left:5px;">
                                                    <span t-field="asi.date_start"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="font-family: 'Helvetica';padding-left:5px;">
                                                    <strong>Estado</strong>
                                                </td>

                                                <t t-if="asi.state == 'draft'">
                                                        <td  style="font-family: 'Helvetica';padding-right:5px;font-color:green;padding-left:5px;" align="left">
                                                            <span>POR INICIAR</span>
                                                        </td>
                                                </t>
                                                <t t-elif="asi.state == 'done'">
                                                            <td  style="font-family: 'Helvetica';padding-right:5px;font-color:red;padding-left:5px;" align="left">
                                                                <span>INICIADO</span>
                                                            </td>
                                                </t>
                                                <t t-elif="asi.state == 'terminate'">
                                                            <td  style="font-family: 'Helvetica';padding-right:5px;font-color:red;padding-left:5px;" align="left">
                                                                <span>CULMINADO</span>
                                                            </td>
                                                </t>
                                                
                                            </tr>
                                            <tr>
                                                <td style="font-family: 'Helvetica';padding-left:5px;">
                                                    <strong>Observaciones</strong>
                                                </td>
                                                
                                                <td style="font-family: 'Helvetica';padding-left:5px;">
                                                    <span t-field="asi.description"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                
                                                <td colspan="2" align="center">
                                                    <strong>LISTADO DE CLASES</strong>
                                                </td>
                                                
                                            </tr>

                                            <t t-set="i" t-value="1"/>

                            </table>

                            <table CELLPADDING="0" CELLSPACING="0" width="100%" name="listado" style="border: 1px solid black; font-size:13px;font-family:Arial;">
                                            <tr>
                                                
                                                <td  colspan="1" align="center">
                                                    <strong>Nª</strong>
                                                </td>
                                                <td  colspan="1" align="center">
                                                    <strong>NOMBRE</strong>
                                                </td>
                                                
                                                <td  colspan="1" align="center">
                                                    <strong>ASISTENCIA</strong>
                                                </td>
                                                <td  colspan="1" align="center">
                                                    <strong>OBSERVACIÒN</strong>
                                                </td>
                                                
                                            </tr>

                                            <t t-set="i" t-value="1"/>
                                            <t t-set="acumEo" t-value="0"/>
                                            <t t-set="acumEe" t-value="0"/>
                                            <t t-set="acumEt" t-value="0"/>

                                            <t t-set="promeO" t-value="0"/>
                                            <t t-set="promeE" t-value="0"/>
                                            <t t-set="promeT" t-value="0"/>
                                            <t t-set="promeRo" t-value="0"/>
                                            <t t-set="promeRe" t-value="0"/>



                                            <t t-foreach="asi.asistencia_ids" t-as="line">

                                                <tr>
                                                    <td  align="right" style="font-family: 'Helvetica';padding-right:5px;">
                                                        <span t-esc="i"/>
                                                    </td>
                                                    <td  style="font-family: 'Helvetica';padding-left:5px;" align="left">
                                                        <span t-field="line.student_id" />
                                                    </td>

                                                    <t t-if="line.is_attended">
                                                        <td  style="font-family: 'Helvetica';padding-right:5px;font-color:green;" align="center">
                                                            <span>ASISTENTE</span>
                                                        </td>
                                                    </t>
                                                   
                                                    <t t-else="">
                                                        <td  style="font-family: 'Helvetica';padding-right:5px;font-color:green;" align="center">
                                                            <span>INASISTENTE</span>
                                                        </td>
                                                    </t>
                                                    
                                                    <td  style="font-family: 'Helvetica';padding-right:5px;" align="left">
                                                        <span t-field="line.description"/>
                                                    </td>
                                                    
                                                </tr>
                                                <t t-set="i" t-value="i+1"/>

                                            </t> 

                                            <t t-set="i" t-value="i-1"/>
                                            

                                            
                            </table>
                        
                      </t>
                   </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
