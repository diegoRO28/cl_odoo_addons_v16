                                    <field name="eva_o" attrs="{'invisible': [('state', '=', 'cancel')]}" widget="integer"/>
                                    <field name="eva_e" attrs="{'invisible': [('state', '=', 'cancel')]}" widget="integer"/>
                                    <field name="eva_t" attrs="{'invisible': [('state', '=', 'cancel')]}" widget="integer"/>

                                    <field name="state_eva" decoration-warning="state_eva =='borrador'" 
