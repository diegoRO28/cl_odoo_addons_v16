<?xml version="1.0" encoding="utf-8"?>

<odoo>
    
    <record id="view_school_standard_form" model="ir.ui.view">
        <field name="name">school.standard.form</field>
        <field name="model">school.standard</field>
        <field name="arch" type="xml">
            <form string="INFORMACIÒN DE LA SECCIÒN" delete="0" duplicate="0">
                <header>
                    <button class="btn-success" name="set_done" string="INICIAR SECCIÒN"  type="object" icon="fa-check" states="draft"
                            confirm="Está seguro de INICIAR EL CURSO ?" groups="school.group_school_administration" />
                    <button class="btn-info" name="set_terminate" string="CERRAR SECCIÒN" type="object" icon="fa-lock" states="done" 
                            confirm="Está seguro de CERRAR LA SECCIÒN ?" groups="school.group_school_administration"/>
                    <button class="btn-danger" name="set_cancel" string="CANCELAR SECCIÒN" type="object" icon="fa-ban" states="draft" 
                            confirm="Está seguro de CANCELAR LA SECCIÒN ?" groups="school.group_school_administration"/>
                    <!-- <button class="btn-warning" name="set_done_corregir" string="VOLVER A INICIADO" type="object" icon="fa-search" states="terminate"
                            confirm="Está seguro de VOLVER A INICIADA LA EVALUACIÓN ?" groups="school.group_school_administration" /> -->
                    <button class="btn-warning" name="set_done_corregir" string="VOLVER A INICIADO" type="object" icon="fa-search" states="terminate"
                            confirm="Está seguro de VOLVER A INICIADA LA EVALUACIÓN ?" groups="school.group_school_administration" />

                    <button class="btn-primary" name="set_avance" string="AVANCE DE CALIFICACIONES" type="object" icon="fa-calculator" states="done" 
                            confirm="Está seguro de calcular AVANCE DE CALIFICACIONES ?" groups="school.group_school_administration,school.group_school_teacher"/>

                    <!-- PARA V2: GENERA LAS EVALUACIONES DE LAS SECCIONES EN LA V1 -->
                    <button class="btn-warning" name="set_genera_reg_eva" string="GENERAR EVALUACIONES" type="object" icon="fa-ambulance" states="done" 
                            confirm="Está seguro de GENERAR LAS EVALUACIONES ?" groups="school.group_school_administration,school.group_school_teacher"/>
                    <button class="btn-warning" name="set_genera_reg_asi" string="GENERAR ASISTENCIAS" type="object" icon="fa-ambulance" states="done" 
                            confirm="Está seguro de GENERAR LAS EVALUACIONES ?" groups="school.group_school_administration,school.group_school_teacher"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,cancel"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Por iniciar" bg_color="bg-warning" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <widget name="web_ribbon" title="Iniciado"   bg_color="bg-success" attrs="{'invisible': [('state', '!=', 'done')]}"/>
                    <widget name="web_ribbon" title="Culminado"  bg_color="bg-info"  attrs="{'invisible': [('state', '!=', 'terminate')]}"/>
                    <widget name="web_ribbon" title="Cancelada"  bg_color="bg-danger"  attrs="{'invisible': [('state', '!=', 'cancel')]}"/>
                    
                    <div class="oe_title">
                            <h3>
                                <field name="name" readonly="1"/>
                            </h3>
                    </div>
                    
                    <group col="3">
                        
                        <group string="INFORMACIÓN DEL CURSO">
                         
                           <field name="code" attrs="{'readonly': [('state', '!=', 'draft')]}" />
                           <field name="school_id"   attrs="{'readonly': [('state', '!=', 'draft')]}" widget="selection" placeholder="Campus"/>
                           
                           <field name="medium_id"   widget="selection" placeholder="Modalidad"/>
                           <field name="standard_id" widget="selection" placeholder="Nivel"/>
                           <field name="division_id" widget="selection" placeholder="Turno"/>
                           <field name="subject_id"  attrs="{'readonly': [('state', '!=', 'draft')]}" placeholder="Curso" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                   
                           <field name="libro_id"    widget="selection" placeholder="Libro de evaluación" readonly="1"/>
                           <field name="company_id" placeholder="Company" readonly="1" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                           <!-- <field name="cmp_id" widget="selection" placeholder="Company"/> -->
                        </group>

                        <group string="INFORMACIÒN DE LA CLASE">
                           <field name="class_room_id" attrs="{'readonly': [('state', 'in', ['terminate'])]}" options="{&quot;no_create&quot;: True}" domain="[('school_id','=',school_id)]" widget="selection" placeholder="Salòn de clases"/>
                           <field name="user_id" attrs="{'readonly': [('state', 'in', ['terminate'])]}" widget="selection" placeholder="Profesor"/>
                           <field name="capacity" attrs="{'readonly': [('state', 'in', ['terminate'])]}"/>
                           <field name="total_students" />
                           <field name="total_students_cancel" />
                           <field name="remaining_seats"/> 
                           <field name="start_date" attrs="{'readonly': [('state', 'in', ['terminate'])]}"/> 
                           <field name="end_date" attrs="{'readonly': [('state', 'in', ['terminate'])]}"/>
                           <field name="code_moodle"  attrs="{'readonly': [('state', 'in', ['terminate'])]}" placeholder="Código Moodle" />       
                        </group>

                        <group string="Promedios">
                            <field name="total_evas" readonly="1" widget="integer"/>
                            <field name="total_evas_terminate" readonly="1" widget="integer"/>
                            <field name="porc_evas_terminate" decoration-success="porc_evas_terminate" readonly="1" widget="integer"/>
                            <field name="average" readonly="1" decoration-bf="average" widget="float"/>
                        </group>
                        
                    </group>
                    <group string="HORARIO"> 
                        <group>
                            <field name="note" colspan="4" placeholder="Ejemplo: Lunes 8:00am - 10:00am" nolabel="1"/>
                        </group>    
                        <field name="name" invisible="1"/>
                        <field name="total_no_subjects" invisible="1"/>
                    </group>
                    <notebook colspan="4">
                        <page string="ESTUDIANTES INSCRITOS" name="students">
                            <field name="student_ids" nolabel="1" colspan="4">
                                <tree string="Student Information" create="0" delete = "0"
                                    
                                    decoration-danger="state_eva == 'aplazado'"
                                    decoration-info="state_eva == 'borrador'"
                                >
                                    <field name="photo" widget="image" class="float-left oe_avatar" readonly="1"/>
                                    <field name="student_code" decoration-bf="1"/>
                                    <field name="student_id" />
                                    <field name="nota" readonly="1" widget="float" decoration-bf="1" />
                                    <!-- <field name="eva_o" attrs="{'invisible': [('state', '=', 'cancel')]}" widget="integer"/>
                                    <field name="eva_e" attrs="{'invisible': [('state', '=', 'cancel')]}" widget="integer"/>
                                    <field name="eva_t" attrs="{'invisible': [('state', '=', 'cancel')]}" widget="integer"/> -->

                                    <field name="state_eva" decoration-warning="state_eva =='borrador'" 
                                                        decoration-success="state_eva =='aprobado'"
                                                        decoration-danger="state_eva =='aplazado'"
                                                        decoration-info="state_eva =='inasistente'"
                                                        widget="badge" attrs="{'invisible': [('state', '=', 'cancel')]}"/>
                                                        
                                    <field name="state_aux" decoration-warning="state_aux =='preinscrito'" 
                                                            decoration-success="state_aux =='inscrito'"
                                                            decoration-info="state_aux =='culminado'"
                                                            decoration-danger="state_aux =='retirado'"
                                                            widget="badge"/>
                                    <field name="state" invisible="1"/>
                                </tree>
                                <form string="Student Information">
                                    <group col="4" colspan="4">
                                       <field name="student_id" readonly="1"/>
                                       <field name="nota" readonly="1" widget="integer"/>
                                       <field name="eva_o" readonly="1" widget="integer"/>
                                       <field name="eva_e" readonly="1" widget="integer"/> 
                                       <field name="eva_t" readonly="1" widget="integer"/>
                                        <field name="state" invisible="1" />
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="PLAN DE ENCUENTROS" name="encuentro" >
                            <field name="asistencia_ids" nolabel="1" colspan="4" editable="0">
                                <tree string="Informaciòn del Encuentro" create="0" delete = "0">
                                    <field name="encuentro_id"/>
                                    <field name="date_start"/>
                                    <field name="state" decoration-warning="state =='draft'" 
                                                        decoration-success="state =='done'"
                                                        decoration-danger="state =='cancel'"
                                                        widget="badge"/>
                                </tree>
                                <form string="Student Information" write="0">
                                    <group col="4" colspan="4">
                                        <field name="encuentro_id" readonly="1"/>
                                        <field name="teacher_id" widget="selection" placeholder="Profesor" readonly="1"/>
                                        <field name="date_start" readonly="1"/>
                                        <field name="note" readonly="1"/>
                                        <field name="state" readonly="1"/>
                                    </group>
                                </form>
                            </field>
                         </page>
                         <!--   <page string="PLAN DE EVALUACIONES" name="evaluacion" >
                            <field name="evaluacion_ids" nolabel="1" colspan="4" editable="0">
                                <tree string="Informaciòn de la Evaluaciòn" create="0" delete = "0">
                                    <field name="evaluacion_id" />
                                    <field name="date_start"/>
                                    <field name="state" decoration-warning="state =='draft'" 
                                                        decoration-success="state =='done'"
                                                        decoration-danger="state =='cancel'"
                                                        widget="badge"/>
                                </tree>
                                <form string="Informaciòn de la Evaluaciòn" write="0">
                                    <group col="4" colspan="4">
                                        <field name="evaluacion_id" readonly="1"/>
                                        <field name="date_start" readonly="1"/>
                                        <field name="description" readonly="1"/>
                                        <field name="state" readonly="1"/>
                                    </group>
                                </form>
                            </field>
                        </page> -->

                      
                        <page string="LIBRO DE EVALUACIONES" name="evaluacion" >
                            <field name="registroeva_ids" nolabel="1" colspan="4" editable="0">
                                <tree string="Informaciòn de la Evaluaciòn" create="0" delete = "0">
                                    
                                    <field name="nombre" />
                                    <field name="date_start"/>
                                    <field name="porc_peso"/>
                                    <field name="state" decoration-warning="state =='draft'" 
                                                        decoration-success="state =='done'"
                                                        decoration-danger="state =='cancel'"
                                                        widget="badge"/>
                                </tree>
                                <form string="Informaciòn de la Evaluaciòn" write="0">
                                    <group col="4" colspan="4">
                                        <field name="libroevas_id" readonly="1"/>
                                        <field name="nombre" />
                                        <field name="date_start" readonly="1"/>
                                        <field name="porc_peso"/>
                                        <field name="note" readonly="1"/>
                                        <field name="state" readonly="1"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                       
                    </notebook>
                </sheet>
                <!-- <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div> -->
            </form>
        </field>
    </record>

    <record id="view_school_standard_form_teacher" model="ir.ui.view">
        <field name="name">school.standard.form.teacher</field>
        <field name="model">school.standard</field>
        <field name="arch" type="xml">
            <form string="INFORMACIÒN DE LA SECCIÒN - PARA EL PROFESOR" delete="0" duplicate="0">
