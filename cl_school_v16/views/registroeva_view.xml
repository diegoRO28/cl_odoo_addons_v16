    <!-- Tree View Of Registro de Asistencia -->
    <record id="view_standard_evaluacion_tree_1" model="ir.ui.view">
        <field name="name">standard.evaluacion.tree.1</field>
        <field name="model">standard.evaluacion</field>
        
        <field name="arch" type="xml">
            <tree string="Información del Registro de Asistencia" create="0" delete="0">
               
                <field name="standard_id"/>
                <field name="subject_id"/>
                <field name="teacher_id"/>
                <field name="libroevas_id"/>
                <field name="date_start"/>
                <field name="note"/>
 
                <field name="state_aux" decoration-warning="state_aux =='por iniciar'" 
                                        decoration-success="state_aux =='iniciado'"
                                        decoration-info="state_aux =='culminado'"
                                        decoration-primary="state_aux =='recuperado'"
                                        widget="badge" optional="show"/>

            </tree>
        </field>
    </record>

    <!-- Search View Of School Standard Information -->
    <record id="view_standard_evaluacion_search" model="ir.ui.view">
        <field name="name">standard.evaluacion.search</field>
        <field name="model">standard.evaluacion</field>
        <field name="arch" type="xml">
            <search string="Información de Grupo">
                <group col="10" colspan="4">
                    <field name="standard_id"/>
                    <field name="teacher_id"/>
                    <field name="subject_id"/>
                    <field name="state"/>
                </group>
                <newline />
                
                <group expand="0" string="Group By..." colspan="12" col="10">
                    <filter name="seccion" string="Secciòn"  help="By Seccion" context="{'group_by':'standard_id'}" />
                    <filter name="subject" string="Curso"    help="By Subject" context="{'group_by':'subject_id'}" />
                    <filter name="teacher" string="Profesor" help="By Teacher" context="{'group_by':'teacher_id'}" />
                    <filter name="state"   string="Status"   help="By state"   context="{'group_by':'state'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Action Of Form & Tree Views Of Registro de Asistencias -->
    <record id="action_standard_evaluacion_form" model="ir.actions.act_window">
        <field name="name">Registro de Evaluaciones</field>
        <field name="res_model">standard.evaluacion</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Action Of Form & Tree Views Of Registro de Asistencias -->
    <record id="action_standard_evaluacion_form_1" model="ir.actions.act_window">
        <field name="name">Registro de Recuperaciones</field>
        <field name="res_model">standard.evaluacion</field>
        <field name="view_id" ref="view_standard_evaluacion_form_1" />
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Action View 2 Of Tree View Of Student Information -->
    <record id="action_standard_evaluacion_tree_1" model="ir.actions.act_window.view">
        <field name="view_mode">tree</field>
        <field eval="20" name="sequence" />
        <field name="view_id" ref="view_standard_evaluacion_tree_1" />
        <field name="act_window_id" ref="action_standard_evaluacion_form_1" />
    </record>

    <menuitem     id="menu_standard_evaluacion_eva"   
                name="Evaluaciones"   
              parent="menu_evaluacion"  
              groups="school.group_school_administration,school.group_school_teacher"/>
             
    <menuitem id="menu_standard_evaluacion_form"   
            name="Registro Evaluaciones"   
            parent="menu_standard_evaluacion_eva" 
            action="action_standard_evaluacion_form"  
            groups="school.group_school_administration,school.group_school_teacher" />

    <menuitem  id="menu_standard_evaluacion_recupera" 
              name="Recuperaciones" 
            parent="menu_evaluacion" 
            groups="school.group_school_administration,school.group_school_teacher"/>
    <menuitem id="menu_standard_evaluacion_recu" 
              name="Registro Recuperaciones" 
              parent="menu_standard_evaluacion_recupera" 
              action="action_standard_evaluacion_form_1" />

</odoo>