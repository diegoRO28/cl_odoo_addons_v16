                                    <field name="nota5" attrs="{'invisible': [('is_act5', '=', False)]}" widget="Integer"/>
                                    <field name="nota6" attrs="{'invisible': [('is_act6', '=', False)]}" widget="Integer" optional="hide"/>

                                    <field name="nota" readonly="1" widget="float"/>

                                    <field name="state" decoration-warning="state =='borrador'" 
