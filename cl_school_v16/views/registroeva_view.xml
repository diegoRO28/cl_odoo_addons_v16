                                                    </div>
                                                </group>
                                    </group>
                                    
                                    
                                    <notebook colspan="4">
                                        <page string="ACTIVIDADES DE LA EVALUACIÓN" name="actividad" >

                                                <field name="actividad_ids"  editable="1">
                                            
                                                    <tree string="Informaciòn de la actividad" create="0" delete = "0" editable="1">
                                                
