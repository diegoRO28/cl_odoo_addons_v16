<?xml version="1.0"?>
<odoo>
    <data>
       <record id="stock_scrap_view_form_inh" model="ir.ui.view">
            <field name="name">custom.stock.scrap.view.form.inh</field>
            <field name="model">stock.scrap</field>
            <field name="inherit_id" ref="stock.stock_scrap_form_view"/>
            <field name="arch" type="xml">
                 <xpath expr="//field[@name='company_id']" position="after">
               
                       <field name="note"/>
                 
                 </xpath>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_stock_scrap_entrega">
            <field name="name">Ordenes de entrega</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">stock.scrap</field>
            <field name="view_mode">tree,form,kanban,pivot,graph</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Picking products
              </p><p>
                Picking a product will remove it from your stock. The product will
                end up in a picking location that can be used for reporting purpose.
              </p>
            </field>
        </record>


        <menuitem
        id="menu_stock_scrap_entrega"
        name="Entregas"
        parent="stock.menu_stock_warehouse_mgmt"
        action="action_stock_scrap_entrega"
        sequence="100"/>

    </data>
</odoo>