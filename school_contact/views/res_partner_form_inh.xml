<?xml version="1.0"?>
<odoo>
    <data>

       <!--  RES.PARTNER -->

       <record id="res_partner_view_form_inh" model="ir.ui.view">
            <field name="name">custom.report.res.partner.view.form.inh</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                
                <xpath expr="//page[@name='sales_purchases']" position="after">    
                            <page string="Información del estudiante" attrs="{'invisible': [('is_student', '=', False)]}">
                                <group col="2">
                                    <group string="INFORMACIÓN DEL ESTUDIANTE">
                                        <field name="is_student" readonly="1"/>
                                        <field name="student_id" readonly="1"/>
                                        <field name="student_ci" readonly="1"/>
                                        <field name="student_code" readonly="1"/> 
                                        <field name="standard_id" readonly="1"/> 
                                        
                                        <field name="note" readonly="1" />
                                    </group>
                                    <group string="INFORMACIÒN DEL REPRESENTANTE">
                                        <field name="parent_name" readonly="1"/>
                                        <field name="parent_ci" readonly="1"/>
                                        <field name="parent_street" readonly="1"/>
                                        <field name="parent_street2" readonly="1"/>
                                        <field name="parent_city" readonly="1"/>
                                        <!--<field name="parent_state_id" readonly="1"/>-->
                                        <field name="parent_phone" readonly="1"/>
                                        <field name="parent_mobile" readonly="1"/>
                                        <field name="parent_email" readonly="1"/> 
                                    </group>
                                </group>
                            </page>
                </xpath>
            </field>
        </record>
   
        <record id="student_ci_partner_filter" model="ir.ui.view">
                <field name="name">Student partnet filter</field>
                <field name="model">res.partner</field>
                <field name="inherit_id" ref="base.view_res_partner_filter"/>
                <field name="arch" type="xml">
                    <xpath expr="//search/field[@name='name']" position="after">
                        <field name="student_code" string="Còdigo Estudiante" filter_domain="[('student_code', 'ilike', self)]"/>
                        <field name="student_ci" string="Cédula Identidad" filter_domain="[('student_ci', 'ilike', self)]"/>
                    </xpath>
                </field>
        </record>

        <!--  SALE.ORDER -->

        <record id="res_sale_order_view_form_inh" model="ir.ui.view">
                <field name="name">custom.report.sale.order.view.form.inh</field>
                <field name="model">sale.order</field>
                <field name="inherit_id" ref="sale.view_order_form"/>
                <field name="arch" type="xml">
                    <xpath expr="//page[@name='other_information']" position="after">    
                                <page string="Información Estudiante" attrs="{'invisible': [('is_student', '=', False)]}">
                                    <group col="2">
                                        <group string="INFORMACIÒN DEL ESTUDIANTE">
                                            <field name="is_student" readonly="1"/>
                                            <field name="student_id" readonly="1"/>
                                            <field name="student_ci" readonly="1"/>
                                            <field name="student_code" readonly="1"/>
                                            <field name="standard_id" readonly="1"/>  
                                            
                                            <field name="note" readonly="1" />
                                        </group>
                                    <group string="INFORMACIÒN DEL REPRESENTANTE">
                                        
                                        <field name="parent_name" readonly="1"/>
                                        <field name="parent_ci" readonly="1"/>
                                        <field name="parent_street" readonly="1"/>
                                        <field name="parent_street2" readonly="1"/>
                                        <field name="parent_city" readonly="1"/>
                                        <!--<field name="parent_state_id" readonly="1"/>-->
                                        <field name="parent_phone" readonly="1"/>
                                        <field name="parent_mobile" readonly="1"/>
                                        <field name="parent_email" readonly="1"/> 
                                    </group>
                                        
                                    </group>
                                </page>
                    </xpath> 
                </field>
            </record>

            <record id="student_ci_sale_filter" model="ir.ui.view">
                    <field name="name">Student Sale filter</field>
                    <field name="model">sale.order</field>
                    <field name="inherit_id" ref="sale.view_sales_order_filter"/>
                    <field name="arch" type="xml">
                        <xpath expr="//search/field[@name='name']" position="after">
                            <field name="student_code" string="Còdigo Estudiante" filter_domain="[('student_code', 'ilike', self)]"/>
                            <field name="student_ci" string="Cédula Identidad" filter_domain="[('student_ci', 'ilike', self)]"/>
                        </xpath>
                    </field>
            </record>

    <!--  ACCOUNT.MOVE -->

        <record id="res_occount_move_view_form_inh" model="ir.ui.view">
                <field name="name">custom.report.account.move.view.form.inh</field>
                <field name="model">account.move</field>
                <field name="inherit_id" ref="account.view_move_form"/>
                <field name="arch" type="xml">

                    <xpath expr="//field[@name='partner_id']" position="after">

                        <group>
                           <field string="Student code" name="student_code" readonly="1" decoration-bf="1" decoration-info="1"  widget="badge"/>
                        </group>

                        <group>
                           <field string="RI" name="inscripcion_id" readonly="1" decoration-bf="1" decoration-info="1"/>
                        </group>

                        <group>
                           <field name="is_inscripcion" invisible="0" decoration-bf="1" decoration-info="1"/>
                        </group>

                    </xpath> 

                    <xpath expr="//page[@name='other_info']" position="after">    
                                <page string="Información Estudiante">
                                    <group col="2">
                                        <group string="INFORMACIÒN DEL ESTUDIANTE">
                                            <field name="is_student" readonly="1"/>
                                            <field name="student_id" readonly="1"/>
                                            <field name="student_ci" readonly="1"/>
                                            <field name="student_code" readonly="1"/> 
                                        </group>
                                    <group string="INFORMACIÒN DEL REPRESENTANTE">
                                        
                                        <field name="parent_name" readonly="1"/>
                                        <field name="parent_ci" readonly="1"/>
                                        <field name="parent_street" readonly="1"/>
                                        <field name="parent_street2" readonly="1"/>
                                        <field name="parent_city" readonly="1"/>
                                        <!--<field name="parent_state_id" readonly="1"/>-->
                                        <field name="parent_phone" readonly="1"/>
                                        <field name="parent_mobile" readonly="1"/>
                                        <field name="parent_email" readonly="1"/> 
                                    </group>
                                        
                                    </group>
                                </page>
                    </xpath> 
                </field>
        </record>

        <record id="view_invoice_tree" model="ir.ui.view">
                <field name="name">view.invoice.tree.inh</field>
                <field name="model">account.move</field>
                <field name="inherit_id" ref="account.view_invoice_tree"/>
                <field name="arch" type="xml">

                    <xpath expr="//field[@name='invoice_partner_display_name']" position="after">
                                 
                       <field name="student_code" string="Student code" decoration-bf="1" decoration-info="1"/>
                       <field name="inscripcion_id" string="RI" decoration-bf="1" decoration-info="1"/>        
                    </xpath> 

                </field>
        </record>

        <record id="student_ci_account_filter" model="ir.ui.view">
                    <field name="name">Student Account filter</field>
                    <field name="model">account.move</field>
                    <field name="inherit_id" ref="account.view_account_invoice_filter"/>
                    <field name="arch" type="xml">
                        <xpath expr="//search/field[@name='name']" position="after">
                            <field name="student_code" string="Còdigo Estudiante" filter_domain="[('student_code', 'ilike', self)]"/>
                            <field name="student_ci" string="Cédula Identidad" filter_domain="[('student_ci', 'ilike', self)]"/>
                        </xpath>
                    </field>
            </record>

    <!--  ACCOUNT.PAYMENT -->

        <record id="view_account_payment_form_inh" model="ir.ui.view">
                <field name="name">view.account.payment.form.inh</field>
                <field name="model">account.payment</field>
                <field name="inherit_id" ref="account.view_account_payment_form"/>
                <field name="arch" type="xml">

                    <xpath expr="//field[@name='partner_id']" position="after">
                                 
                       <field string="Código Estudiante" name="student_code" readonly="1" decoration-bf="1" decoration-info="1"/>
                                
                    </xpath> 
                    
                </field>
        </record>

        <record id="view_account_payment_tree_inh" model="ir.ui.view">
                <field name="name">view.account.payment.tree.inh</field>
                <field name="model">account.payment</field>
                <field name="inherit_id" ref="account.view_account_payment_tree"/>
                <field name="arch" type="xml">

                    <xpath expr="//field[@name='partner_id']" position="after">
                                 
                       <field string="Cód Est" name="student_code" readonly="1" decoration-bf="1" decoration-info="1"/>
                                
                    </xpath> 
                    
                </field>
        </record>

      </data>
</odoo>