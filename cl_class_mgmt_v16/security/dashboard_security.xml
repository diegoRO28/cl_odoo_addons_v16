<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="rule_cl_academic_dashboard_own" model="ir.rule">
        <field name="name">Dashboard Académica: solo mi propia configuración</field>
        <field name="model_id" ref="model_cl_academic_dashboard"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <record id="rule_cl_admin_dashboard_own" model="ir.rule">
        <field name="name">Dashboard Administrativa: solo mi propia configuración</field>
        <field name="model_id" ref="model_cl_admin_dashboard"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

</odoo>
