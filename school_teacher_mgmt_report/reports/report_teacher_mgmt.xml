<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Definición de la Acción del Reporte -->
    <record id="report_teacher_mgmt_action" model="ir.actions.report">
        <field name="name">Gestión Docente</field>
        <field name="model">teacher.mgmt.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">school_teacher_mgmt_report.report_teacher_mgmt</field>
        <field name="report_file">school_teacher_mgmt_report.report_teacher_mgmt</field>
        <field name="print_report_name">'Reporte_Gestion_Docente_%s' % (fields.Date.today().strftime('%Y-%m-%d'))</field>
        <field name="binding_type">report</field>
    </record>

    <!-- Template del Reporte -->
    <template id="report_teacher_mgmt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- Encabezado del reporte -->
                        <div style="border-bottom: 2px solid #000; margin-bottom: 15px;">
                            <h1 class="text-center" style="color: #2c3e50;">Reporte de Gestión Docente</h1>
                            <h4 class="text-center" style="color: #7f8c8d;">
                                Fecha de Emisión: 
                                <span t-field="wizard.date_today" t-options='{"widget": "date", "format": "dd-MM-yyyy"}'/>
                            </h4>
                        </div>

                        <!-- Filtros aplicados -->
                        <div class="row" style="margin-bottom: 15px;">
                            <div class="col-md-6" style="padding: 5px 10px;">
                                <strong style="color: #2c3e50;">Profesor:</strong> 
                                <span style="color: #34495e;" t-esc="wizard.filters.get('teacher')"/>
                            </div>
                            <div class="col-md-6" style="padding: 5px 10px;">
                                <strong style="color: #2c3e50;">Código de Sección:</strong> 
                                <span style="color: #34495e;" t-esc="wizard.filters.get('section_code')"/>
                            </div>
                        </div>

                        <hr style="border-top: 1px solid #bdc3c7;"/>

                        <!-- Listado de Secciones -->
                        <h3 style="color: #2c3e50; margin-bottom: 10px;">
                            <i class="fa fa-list"/> Secciones Encontradas
                            <span style="font-size: 14px; color: #7f8c8d; font-weight: normal;">
                                (Total: <t t-esc="wizard.total_sections"/> secciones)
                            </span>
                        </h3>

                        <table class="table table-bordered table-striped" style="width: 100%; border-collapse: collapse; font-size: 11px;">
                            <thead>
                                <tr style="background-color: #2c3e50; color: white;">
                                    <th style="padding: 8px; border: 1px solid #34495e; text-align: center;">#</th>
                                    <th style="padding: 8px; border: 1px solid #34495e; text-align: left;">Código</th>
                                    <th style="padding: 8px; border: 1px solid #34495e; text-align: left;">Curso</th>
                                    <th style="padding: 8px; border: 1px solid #34495e; text-align: left;">Profesor</th>
                                    <th style="padding: 8px; border: 1px solid #34495e; text-align: left;">Nivel</th>
                                    <th style="padding: 8px; border: 1px solid #34495e; text-align: left;">Turno</th>
                                    <th style="padding: 8px; border: 1px solid #34495e; text-align: center;">Total Estudiantes</th>
                                    <th style="padding: 8px; border: 1px solid #34495e; text-align: center;">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="counter" t-value="0"/>
                                <t t-set="sections" t-value="wizard.sections"/>
                                <tr t-foreach="sections" t-as="section" style="border-bottom: 1px solid #ecf0f1;">
                                    <t t-set="counter" t-value="counter + 1"/>
                                    <td style="padding: 6px; border: 1px solid #ecf0f1; text-align: center;">
                                        <span t-esc="counter"/>
                                    </td>
                                    <td style="padding: 6px; border: 1px solid #ecf0f1;">
                                        <span t-field="section.code"/>
                                    </td>
                                    <td style="padding: 6px; border: 1px solid #ecf0f1;">
                                        <span t-field="section.subject_id.name"/>
                                    </td>
                                    <td style="padding: 6px; border: 1px solid #ecf0f1;">
                                        <span t-field="section.user_id.name"/>
                                    </td>
                                    <td style="padding: 6px; border: 1px solid #ecf0f1;">
                                        <span t-field="section.standard_id.name"/>
                                    </td>
                                    <td style="padding: 6px; border: 1px solid #ecf0f1;">
                                        <span t-field="section.division_id.name"/>
                                    </td>
                                    <td style="padding: 6px; border: 1px solid #ecf0f1; text-align: center;">
                                        <span t-field="section.total_students"/>
                                    </td>
                                    <td style="padding: 6px; border: 1px solid #ecf0f1; text-align: center;">
                                        <span t-field="section.state" t-field-options='{"widget": "badge"}'/>
                                    </td>
                                </tr>
                                <t t-if="not sections">
                                    <tr>
                                        <td colspan="8" style="padding: 15px; text-align: center; color: #e74c3c; font-weight: bold;">
                                            <i class="fa fa-warning"/> No se encontraron secciones con los filtros seleccionados.
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Pie de página del reporte -->
                        <div style="margin-top: 20px; border-top: 1px solid #bdc3c7; padding-top: 10px;">
                            <table style="width: 100%; font-size: 10px; color: #7f8c8d;">
                                <tr>
                                    <td style="text-align: left;">
                                        <strong>Total de Secciones:</strong> <t t-esc="wizard.total_sections"/>
                                    </td>
                                    <td style="text-align: right;">
                                        <span t-esc="wizard.company.name"/> - <span t-field="wizard.date_today" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/>
                                    </td>
                                </tr>
                            </table>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>