<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista del Wizard -->
    <record id="view_teacher_mgmt_wizard_form" model="ir.ui.view">
        <field name="name">teacher.mgmt.wizard.form</field>
        <field name="model">teacher.mgmt.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar Reporte de Gestión Docente">
                <sheet>
                    <div class="oe_title">
                        <h1>Parámetros del Reporte</h1>
                    </div>
                    <group>
                        <field name="teacher_id" 
                               placeholder="Seleccione un Profesor..." 
                               options="{'no_create': True, 'no_edit': True}"/>
                        <field name="section_code" 
                               placeholder="Ej: MAT-01"/>
                        <field name="date_today" invisible="1"/>
                        <div class="text-muted">
                            <i class="fa fa-info-circle"/> El reporte se generará con la fecha de hoy.
                        </div>
                    </group>
                    <footer>
                        <button name="generate_report" 
                                string="Generar Reporte" 
                                type="object" 
                                class="btn-primary"/>
                        <button string="Cancelar" 
                                class="btn-default" 
                                special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción del Wizard para el Menú -->
    <record id="action_report_teacher_mgmt" model="ir.actions.act_window">
        <field name="name">Gestión Docente</field>
        <field name="res_model">teacher.mgmt.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Genere un reporte de Gestión Docente.
            </p>
            <p>
                Puede filtrar la información por Profesor o por Código de Sección.
            </p>
        </field>
    </record>
</odoo>