<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista del Wizard -->
    <record id="view_teacher_mgmt_wizard_form" model="ir.ui.view">
        <field name="name">teacher.mgmt.wizard.form</field>
        <field name="model">teacher.mgmt.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar Reporte de Gestión Docente">
                <sheet>
                    <div class="oe_title">
                        <h1>Parámetros del Reporte</h1>
                    </div>
                    <group>
                        <!-- Profesor - Filtro principal -->
                        <field name="teacher_id" 
                               placeholder="Seleccione un Profesor..." 
                               options="{'no_create': True, 'no_edit': True}"/>
                        
                        <!-- Curso - Filtrado dinámicamente por el profesor seleccionado -->
                        <field name="subject_id" 
                               placeholder="Seleccione un Curso..." 
                               options="{'no_create': True, 'no_edit': True}"/>
                        
                        <!-- Sección - Filtrada dinámicamente por el curso seleccionado -->
                        <field name="section_id" 
                               placeholder="Seleccione una Sección..." 
                               options="{'no_create': True, 'no_edit': True}"/>
                        
                        <field name="date_today" invisible="1"/>
                        
                        <div class="text-muted" style="margin-top: 10px;">
                            <i class="fa fa-info-circle"/> Los filtros son opcionales y se encadenan automáticamente:
                            <ul style="margin-top: 5px; padding-left: 20px;">
                                <li><i class="fa fa-arrow-right"/> Seleccione un <strong>Profesor</strong> para ver solo sus cursos.</li>
                                <li><i class="fa fa-arrow-right"/> Seleccione un <strong>Curso</strong> para ver solo sus secciones.</li>
                                <li><i class="fa fa-arrow-right"/> Seleccione una <strong>Sección</strong> para ver solo esa sección.</li>
                            </ul>
                        </div>
                    </group>
                    <footer>
                        <button name="generate_report" 
                                string="Generar Reporte" 
                                type="object" 
                                class="btn-primary"/>
                        <button string="Cancelar" 
                                class="btn-default" 
                                special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción del Wizard para el Menú -->
    <record id="action_report_teacher_mgmt" model="ir.actions.act_window">
        <field name="name">Gestión Docente</field>
        <field name="res_model">teacher.mgmt.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Genere un reporte de Gestión Docente en formato Excel.
            </p>
            <p>
                Puede filtrar la información por:
                <ul>
                    <li><strong>Profesor</strong>: Seleccione un profesor específico</li>
                    <li><strong>Curso</strong>: Seleccione un curso específico (se filtra automáticamente por el profesor seleccionado)</li>
                    <li><strong>Sección</strong>: Seleccione una sección específica (se filtra automáticamente por el curso seleccionado)</li>
                </ul>
            </p>
            <p>
                Los filtros son opcionales y se encadenan automáticamente.
            </p>
        </field>
    </record>
</odoo>