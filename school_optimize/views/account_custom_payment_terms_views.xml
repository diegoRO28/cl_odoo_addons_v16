<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="account_custom_payment_terms_tree_view" model="ir.ui.view">
            <field name="name">account.custom.payment.terms.tree.view</field>
            <field name="model">account.custom.payment.terms</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="days"/>
                    <field name="description"/>
                </tree>
            </field>
        </record>

        <record id="account_custom_payment_terms_form_view" model="ir.ui.view">
            <field name="name">account.custom.payment.terms.form.view</field>
            <field name="model">account.custom.payment.terms</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1"/>
                            </group>
                            <group>
                                <field name="days" required="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Descripción" name="description_page">
                                <field name="description" nolabel="1"/>                            
                            </page>
                        </notebook>                         
                    </sheet>
                </form>
            </field>
        </record>
        
        <record id="action_account_custom_payment_terms" model="ir.actions.act_window">
            <field name="name">Plazos de pago</field>
            <field name="res_model">account.custom.payment.terms</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem 
            id="menu_account_custom_payment_terms" 
            name="Plazos de pago" 
            parent="account.account_invoicing_menu" 
            action="school_optimize.action_account_custom_payment_terms" 
            groups="account.group_account_manager"
            sequence="1"
        />        

        <!-- Ocultando elemento de menú Plazos de pago nativo -->
        <record id="account.menu_action_payment_term_form" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>        
    </data>
</odoo>
