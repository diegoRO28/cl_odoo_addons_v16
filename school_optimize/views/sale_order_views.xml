<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_school_optimize_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.school.optimize.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="student_code_related" attrs="{'invisible': [('student_code_related', '=', False)]}" />
                <field name="standard_id" attrs="{'invisible': [('standard_id', '=', False)]}" />
            </xpath> 
        </field>
    </record>

    <record id="view_sale_order_list_school_optimize_inherit" model="ir.ui.view">
        <field name="name">sale.order.list.school.optimize.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="student_code_related" />
            </xpath> 
        </field>
    </record>    
</odoo>