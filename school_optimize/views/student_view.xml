<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_student_student_form_1_inherit" model="ir.ui.view">
        <field name="name">student.student.form.1.inherited</field>
        <field name="model">student.student</field>
        <field name="inherit_id" ref="school.view_student_student_form_1"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general']" position="replace"/>
            <xpath expr="//group[4]" position="inside">
                <group>
                    <separator string="Información General"/>
                    <!-- <field name="cast_id" attrs="{'readonly':[('state','in',['alumni','terminate'])]}" widget="selection" placeholder="Religion/Caste"/> -->
                    <field name="date_of_birth" widget="date" placeholder="Birthdate" attrs="{'readonly':[('state','in',['alumni','terminate'])]}"/>
                    <field name="gender" attrs="{'readonly':[('state','in',['alumni','terminate'])]}" placeholder="Sexo" required="1"/>
                    <field name="age"/>
                    <field name="admission_date" widget="date" placeholder="Admission Date" attrs="{'readonly':[('state','in',['alumni','terminate'])]}" readonly="1"/>                    
                </group>
                <group>
                    <separator string="INFORMACIÒN DE CONTACTO (EMERGENCIA)"/>
                    <newline/>
                    <field name="contact_phone" attrs="{'readonly':[('state','in',['alumni','terminate'])]}" placeholder="Phone Number"/>
                    <field name="contact_mobile" attrs="{'readonly':[('state','in',['alumni','terminate'])]}" placeholder="Mobile Number"/>                    
                    <newline/>
                    <separator string="Termination Reason" attrs="{'invisible':[('state','in',['draft','done','alumni'])]}"/>
                    <field name="terminate_reason" attrs="{'invisible':[('state','in',['draft','done','alumni'])]}" readonly="1"/>                  
                </group>
            </xpath>
            <xpath expr="//field[@name='parent_id']" position="attributes">
                <attribute name="context">{'form_view_ref': 'school_optimize.view_school_parent_optimize_form', 'default_parent_school': 1}</attribute>
            </xpath>
            <xpath expr="//field[@name='admission_date']" position="after">
                <field name="allow_edit_admission_date" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='admission_date']" position="attributes">
                <attribute name="readonly"></attribute>
            </xpath>
            <xpath expr="//field[@name='admission_date']" position="attributes">
                <attribute name="attrs">{'readonly': [('allow_edit_admission_date', '=', False)]}</attribute>
            </xpath>
            <!-- ========== Estudiantes desde Contacto ==========-->
            <xpath expr="//label[@for='name'][1]" position="attributes">
                <attribute name="invisible">context.get('student_from_contact')</attribute>
            </xpath>
            <xpath expr="//field[@name='name'][1]" position="attributes">
                <attribute name="invisible">context.get('student_from_contact')</attribute>
            </xpath>                           
            <xpath expr="//group[1]" position="inside">
                <field name="is_created_from_existing_contact" invisible="1"/>
                <field name="created_from_contact_done" invisible="1"/>
                <field name="show_contact_id_field" invisible="1"/>
                <field name="show_contact_student_name_field" invisible="1"/>
                
                <label for="contact_id" class="oe_edit_only" attrs="{'invisible': [('show_contact_id_field', '=', False)]}"/>
                <h1 attrs="{'invisible': [('show_contact_id_field', '=', False)]}">
                    <field name="contact_id" required="context.get('student_from_contact')" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}" domain="[('is_student', '=', False)]"/>
                </h1>

                <label for="name" class="oe_edit_only" attrs="{'invisible': [('show_contact_student_name_field', '=', False)]}"/>
                <h1 attrs="{'invisible': [('show_contact_student_name_field', '=', False)]}">
                    <!-- <field name="middle" placeholder="Nombre del estudiante" /> -->
                    <field name="name" String="Nombres/Apellidos" placeholder="Nombre del estudiante"/>
                </h1>
            </xpath> 
            <!-- ========== Usuario y contacto relacionado ========== -->
            <!--
            <xpath expr="//field[@name='parent_name']" position="before">
                <field name="user_id" attrs="{'invisible': [('id', '=', False)]}" groups="base.group_no_one" readonly="1"/>
                <field name="partner_id" attrs="{'invisible': [('id', '=', False)]}" groups="base.group_no_one" readonly="1"/>
            </xpath>                                              
            -->
        </field>
    </record>

    <!-- ========== Estudiantes desde Contacto ==========-->
    <record id="action_student_student_from_contact_form" model="ir.actions.act_window">
        <field name="name">Estudiantes Regulares desde Contacto</field>
        <field name="res_model">student.student</field>
        <field name="domain">[('is_created_from_existing_contact', '=', True)]</field>
        <field name="context">{
            'default_is_created_from_existing_contact': True,
            'student_from_contact': 1,
        }</field>
        <field name="view_mode">tree,form</field>
    </record>   

    <menuitem
        id="menu_student_profile_from_contact"
        name="Estudiantes desde Contacto"
        action="school_optimize.action_student_student_from_contact_form"
        parent="school.menu_school_record"
        groups="school.group_school_administration,school.group_school_student,school.group_school_parent"
        sequence="31"/>

</odoo>