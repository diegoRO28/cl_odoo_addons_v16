<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="account_payment_concept_tree_view" model="ir.ui.view">
            <field name="name">account.payment.concept.tree.view</field>
            <field name="model">account.payment.concept</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record id="account_payment_concept_form_view" model="ir.ui.view">
            <field name="name">account.payment.concept.form.view</field>
            <field name="model">account.payment.concept</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1"/>
                            </group>
                            <group />
                        </group>                         
                    </sheet>
                </form>
            </field>
        </record>
        
        <record id="action_account_payment_concept" model="ir.actions.act_window">
            <field name="name">Concepto de pago</field>
            <field name="res_model">account.payment.concept</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem 
            id="menu_account_payment_concept" 
            name="Concepto de pago" 
            parent="account.account_invoicing_menu" 
            action="school_optimize.action_account_payment_concept" 
            groups="account.group_account_manager"
        />        
    </data>
</odoo>
