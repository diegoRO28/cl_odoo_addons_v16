<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_school_optimize_inherit" model="ir.ui.view">
        <field name="name">account.journal.form.school.optimize.inherit</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="is_zelle" />
                <field name="is_pago_movil" />
            </xpath> 
        </field>
    </record>

    <record id="view_account_journal_list_school_optimize_inherit" model="ir.ui.view">
        <field name="name">account.journal.list.school.optimize.inherit</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="is_zelle" />
                <field name="is_pago_movil" />
            </xpath> 
        </field>
    </record>    
</odoo>