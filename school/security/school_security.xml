            ]</field>
        </record>

        <!-- Rule For STUDENT_INSCRIPCION company -->
        <record model="ir.rule" id="student_inscripcion_comp_rule">
            <field name="name">Student Inscripcion multi-company</field>
            <field name="model_id" ref="model_student_inscripcion"/>
