<?xml version="1.0" encoding="utf-8"?>    
<odoo>    

    <!-- Form View Of School Information -->
    <record id="view_school_curso_form" model="ir.ui.view">
        <field name="name">school.curso.form</field>
        <field name="model">school.curso</field>
        <field name="arch" type="xml">
            <form string="Campus Information">
                <sheet>
                    <separator string="Información del Campus" />
                    <group col="4" colspan="4">
                        <field name="name" string="Curso Nro." placeholder="Curso" />
                        <field name="school_id"/>
                        <field name="subject_id" />
                    </group>
                    <group>
                        
                        
                    </group>
                    <group col="4" colspan="4">
                        
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View Of School Information -->
    <record id="view_school_school_tree" model="ir.ui.view">
        <field name="name">school.curso.tree</field>
        <field name="model">school.curso</field>
        <field name="arch" type="xml">
            <tree string="Sedes Information">
                <field name="name" string="Nombre" />
                <field name="school_id" />
            </tree>
        </field>
    </record>

    <!-- Action Of Form & Tree Views Of School Information -->
    <record id="action_school_curso_form" model="ir.actions.act_window">
        <field name="name">Cursos</field>
        <field name="res_model">school.curso</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- MENU Of School Information -->
