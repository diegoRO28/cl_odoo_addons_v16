<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <!-- Tree View 1 Of Student's Profiles -->
    <record id="view_student_cambio_tree" model="ir.ui.view">
        <field name="name">student.cambio.tree.1</field>
        <field name="model">student.cambio</field>
        <field name="arch" type="xml">
            <tree string="Student Information" delete="1" 
                                    decoration-danger="state == 'cancel'"
                                    decoration-info="state == 'terminate'"
            >
                <field name="name" />
                <field name="cambio_date" />
                <field name="student_code" decoration-info="1" decoration-bf="1" widget="badge"/>
                <field name="student_id" />
                <field name="school_id" />
                <field name="standard_id" />

                <field name="state" decoration-warning="state =='draft'" 
                                        decoration-success="state =='done'"
                                        decoration-info="state =='terminate'"
                                        decoration-danger="state =='cancel'"
                                        widget="badge"           />
            </tree>
        </field>
    </record>

    <!-- Form View 1 Of Student's Profiles -->
    <record id="view_student_cambio_form" model="ir.ui.view">
        <field name="name">student.cambio.form</field>
        <field name="model">student.cambio</field>
        <field name="arch" type="xml">
            <form string="Cambio de Sección">
                <header>
                    <button name="admission_done" string="Confirmar Cambio" type="object" 
                            class="btn-primary" states="draft"/>
                    <button name="action_ver_cadena_cambios" string="Ver Cadena Completa" type="object" 
                            class="btn-secondary"/>
                    <button name="action_nuevo_cambio" string="Nuevo Cambio" type="object" states="terminate" 
                            class="btn-primary"/>
                    <button name="action_revertir_ultimo_cambio" string="Revertir Último Cambio" type="object" 
                            class="btn-danger" states="terminate"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,terminate"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="student_code"/>
                            <field name="ri_id" readonly="1" options="{'no_create': True, 'no_search': True}"/>
                            <field name="cambio_date"/>
                            <field name="tipocambio_id"/>
                        </group>
                        <group>
                            <field name="photo" widget="image" class="oe_avatar"/>
                        </group>
                    </group>
                
                    <group string="Secciones">
                        <group string="Origen">
                            <field name="seccion_origen_hist" string="Sección Origen" readonly="1"/>
                            <field name="school_id" readonly="1" string="Campus Origen"/>
                            <field name="subject_id" readonly="1"/>
                        </group>
                        <group string="Destino">
                            <field name="school_des_id" string="Campus Destino" required="1"/>
                            <field name="standard_des_id" 
                                   domain="[('school_id','=',school_des_id), ('id','!=', seccion_origen_hist)]" 
                                   required="1"/>
                            <field name="subject_des_id" readonly="1"/>
                            <field name="remaining_seats_destino" string="Cupos Disponibles" readonly="1"/>
                        </group>
                    </group>
                
                    <group string="Información Adicional">
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
  
    <!-- Action Of Form, Tree & Kanban Views Of Student Information -->
    <record id="action_student_cambio" model="ir.actions.act_window">
        <field name="name">Registro de Cambios de Sección</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">student.cambio</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first cambio!
            </p>
        </field>
    </record>

    <menuitem id = "menu_student_cambio" 
            name = "Registro de Cambio de Sección" 
          action = "action_student_cambio" 
          parent = "menu_admission_form_root_cambio" 
          groups = "school.group_school_administration,school.group_is_admission" 
        sequence = "9" />

</odoo>