<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <!-- Tree View 1 Of Student's Profiles -->
    <record id="view_student_inscripcion_tree" model="ir.ui.view">
        <field name="name">student.inscripcion.tree.1</field>
        <field name="model">student.inscripcion</field>
        <field name="arch" type="xml">
            <!-- <tree string="Student Information" create="false" delete="false"> -->
            <tree string="Student Information" delete="0" 
                                    decoration-danger="state == 'cancel'"
                                    decoration-info="state == 'terminate'"
            >
                <field name="name" />
                <field name="inscription_date" />
                <field name="move_id" />
                <field name="student_code" decoration-info="1" decoration-bf="1" widget="badge" />
                <field name="student_id" />
                <field name="school_id" />
                <field name="standard_id" />
                <field name="state" invisible="1" />

                <field name="state_aux" decoration-warning="state_aux =='preinscrito'" 
                                        decoration-success="state_aux =='inscrito'"
                                        decoration-info="state_aux =='culminado'"
                                        decoration-danger="state_aux =='retirado'"
                                        widget="badge"           />
             </tree>
        </field>
    </record>

    <!-- Form View 1 Of Student's Profiles -->
    <record id="view_student_inscripcion_form" model="ir.ui.view">
        <field name="name">student.inscripcion.form.1</field>
        <field name="model">student.inscripcion</field>
        <field name="arch" type="xml">
            <!-- <form string="Student Information" create="false" delete="false"> -->
            <form string="Student Information" delete="0" duplicate="0">
                <header>
                    <!-- <button class="oe_highlight oe_stat_button" name="%(school.action_terminate_wizard)d" string="Terminate" type="action" icon="fa-ban" states="done" groups="school.group_school_administration" /> -->
                    <!-- <button class="oe_stat_button" name="set_alumni" string="Alumni" type="object" icon="fa-archive" states="done" groups="school.group_school_administration" /> -->
                    <button class="btn-success" icon="fa-check" name="admission_done" type="object" confirm="Está seguro de Confirmar la Inscripción ?"
                            string="CONFIRMAR INSCRIPCIÒN" states="draft" groups="school.group_school_administration" /> 
                    <!-- <button class="btn-danger" icon="fa-ban" name="cancel_admission" type="object" confirm="Está seguro de Cancelar la Inscripción ?"
                            string="CANCELAR INSCRIPCIÒN" states="done" groups="school.group_school_administration"/> -->
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,terminate,cancel"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Preinscrito" bg_color="bg-warning" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <widget name="web_ribbon" title="Inscrito"   bg_color="bg-success" attrs="{'invisible': [('state', '!=', 'done')]}"/>
                    <widget name="web_ribbon" title="Culminado"  bg_color="bg-info"  attrs="{'invisible': [('state', '!=', 'terminate')]}"/>
                    <widget name="web_ribbon" title="Retirado"  bg_color="bg-danger"  attrs="{'invisible': [('state', '!=', 'cancel')]}"/>

                    <div class="oe_button_box" name="buttons"></div>
                   
                    <div class="oe_title">
                            <h3>
                                <field name="name" readonly="1"/>
                            </h3>
                    </div>

                    <group col="2" string="INFORMACIÓN DEL ESTUDIANTE">
                                    
                                    <group >
                                        <field name="student_id" placeholder="Estudiante" required="1" attrs="{'readonly': [('state', 'in', ['done','terminate'])]}" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                                        <field name="student_code" string="Código" placeholder="Estudiante" readonly="1" required="1" attrs="{'readonly': [('state', 'in', ['done','terminate'])]}"
                                                decoration-info="1"
                                                widget="badge"
                                        />
                                        <field name="student_partner_id" string="Contacto" placeholder="Estudiante" readonly="1" required="1" attrs="{'readonly': [('state', 'in', ['done','terminate'])]}"/>
                                    </group>
                                    <group>
                                        <field name="photo" widget="image" class="float-left oe_avatar" readonly="1" nolabel="1"/>
                                    </group>
                             
                    </group>

                    <!-- <group col="2">
                        
                        <group string="INFORMACIÓN DEL ESTUDIANTE">
                                 <field name="student_id" placeholder="Estudiante" required="1" attrs="{'readonly': [('state', 'in', ['done','terminate'])]}" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                                 <field name="student_code" string="Código" placeholder="Estudiante" readonly="1" required="1" attrs="{'readonly': [('state', 'in', ['done','terminate'])]}"/>
 
                        </group>
                        
                        <group string="INFORMACIÓN DE LA FACTURA">
                                <field name="move_id" placeholder="Factura Asociada" help="Seleccione la factura" domain="[('move_type','=', 'out_invoice'),('partner_id','=', student_partner_id),('is_inscripcion','=', False)]"  attrs="{'readonly': [('state', 'in', ['done','terminate'])]}" options="{'no_edit': True, 'no_create': True, 'no_open': True}" />
                                <field name="partner_id" string="Contacto" placeholder="Contacs" widget="selection" attrs="{'invisible': [('move_id', '=', False)]}" help="Seleccione el Contacto"/>
                                <field name="move_type" string="Tipo" invisible="0" attrs="{'invisible': [('move_id', '=', False)]}"/>
                                <field name="state_invoice" string="Status" invisible="0" attrs="{'invisible': [('move_id', '=', False)]}"/>
                        </group>

                    </group> -->

                    <group col="3">
                            <group string="INFORMACIÓN DE LA FACTURA">
                                <!-- <field name="move_id" placeholder="Factura Asociada" help="Seleccione la factura" 
                                    domain="[('move_type','=', 'out_invoice'),('partner_id','=', student_partner_id),('is_inscripcion','=', False)]"  
                                    attrs="{'readonly': [('state', 'in', ['done','terminate','cancel'])]}" 
                                    options="{'no_edit': True, 'no_create': True, 'no_open': True}" 
                                /> -->

                                <field name="move_id" placeholder="Factura Asociada" help="Seleccione la factura" 
                                    domain="[('partner_id','=', student_partner_id),('move_type','=', 'out_invoice'),('is_inscripcion','=',False)]"  
                                    attrs="{'readonly': [('state', 'in', ['done','terminate','cancel'])]}" 
                                    options="{'no_edit': True, 'no_create': True, 'no_open': True}" 
                                />
                                
                                
                                <field name="partner_id" string="Contacto" placeholder="Contacs" widget="selection" attrs="{'invisible': [('move_id', '=', False)]}" help="Seleccione el Contacto"/>
                                <field name="move_type" string="Tipo" invisible="0" attrs="{'invisible': [('move_id', '=', False)]}"/>
                                <field name="payment_state" string="Status Pago" invisible="0" attrs="{'invisible': [('move_id', '=', False)]}"/>
                             </group>
                        <group string="INFORMACIÓN DE LA SEDE">
                            <field name="school_id" placeholder="Campus" widget="selection" help="School of Student" attrs="{'readonly': [('state', 'in', ['done','terminate','cancel'])]}"/>
                            <field name="company_id" placeholder="Compañía" readonly="1" widget="selection" />
                        </group>

                        <group string="INFORMACIÓN DE LA SECCIÓN">
                           
                            <field name="standard_id" placeholder="Secciòn" domain="[('school_id','=', school_id) , ('state','in',['draft','done']),('remaining_seats','>',0)]" attrs="{'readonly': [('state', 'in', ['done','terminate','cancel'])]}" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/> 
                            <field name="subject_id" placeholder="Curso" widget="selection" readonly="1"/>
                            <field name="inscription_date" placeholder="Fecha Inscripciòn" widget="date" help="Escriba la fecha" attrs="{'readonly': [('state', 'in', ['done','terminate','cancel'])]}"/>
                            
                            <field name="state_eva" attrs="{'invisible': [('state', 'not in', ['terminate'])]}"
                                        decoration-warning="state_eva =='borrador'" 
                                        decoration-success="state_eva =='aprobado'"
                                        decoration-danger="state_eva =='aplazado'"
                                        widget="badge" />

                        </group>
                    </group>

                    <separator string="Observaciones" />
                    <group colspan="4">
                       <field name="note" colspan="2" placeholder="Observaciones" nolabel="1" widget="text" attrs="{'readonly': [('state', 'in', ['done','terminate','cancel'])]}"/>
                    </group>
                    
                    
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View Of School Standard Information -->
    <record id="view_student_inscripcion_search" model="ir.ui.view">
        <field name="name">school.inscripcion.search</field>
        <field name="model">student.inscripcion</field>
        <field name="arch" type="xml">
            <search string="Información de Grupo">
                <group col="10" colspan="4">

                    <field name="student_code" string="Código estudiante"/>
                    <field name="student_id" string="Nombre estudiante" />
                    <field name="standard_id"  string="Sección"/>
                    <field name="school_id" string="Campus"/>
                   
                </group>
                <newline />
                <group expand="0" string="Group By..." colspan="12" col="10">
                    <filter name="school" string="Estudiante" help="By Sedes" context="{'group_by':'student_id'}" />
                    <filter name="school" string="Campus" help="By Sedes" context="{'group_by':'school_id'}" />
                    <filter name="class" string="Secciòn" help="By Class" context="{'group_by':'standard_id'}" />
                    <filter name="medium" string="Status" help="By Status" context="{'group_by':'state'}" />
                </group>
            </search>
        </field>
    </record>
  
    <!-- Action Of Form, Tree & Kanban Views Of Student Information -->
    <record id="action_student_inscripcion" model="ir.actions.act_window">
        <field name="name">Registro de Inscripción</field>
        <field name="type">ir.actions.act_window</field>
        <!-- <field name="domain">[('state', '=', 'done')]</field> -->
        <field name="res_model">student.inscripcion</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Inscripciòn!
            </p>
        </field>
    </record>

    <menuitem id = "menu_student_inscripcion" 
            name = "Registro de Inscripción" 
          action = "action_student_inscripcion" 
          parent = "menu_admission_form_root" 
          groups = "school.group_school_administration,school.group_is_admission" 
        sequence = "2" />

</odoo>
