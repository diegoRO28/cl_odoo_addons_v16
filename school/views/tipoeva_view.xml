<?xml version="1.0" encoding="utf-8"?>    
<odoo>    

    <!-- Form View Of School Information -->
    <record id="view_school_tipoeva_form" model="ir.ui.view">
        <field name="name">school.tipoeva.form</field>
        <field name="model">school.tipoeva</field>
        <field name="arch" type="xml">
            <form string="tipoeva Information">
                <sheet>
                    <separator string="Información del tipoeva" />
                    <group col="4" colspan="4">
                        
                        <field name="name" string="Nombre" placeholder="tipoeva" /> 
                        <field name="code" placeholder="Código" />
                        <field name="is_recupera"  widget="boolean_toggle" placeholder="Escriba si acepta recuperación"/>

                
                    </group>
                    
                    
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View Of School Information -->
    <record id="view_school_school_tree" model="ir.ui.view">
        <field name="name">school.tipoeva.tree</field>
        <field name="model">school.tipoeva</field>
        <field name="arch" type="xml">
            <tree string="tipoeva Information">
                <!-- <field name="company_id" /> -->
                <field name="name" string="Nombre" />
                <field name="code" />
                <field name="is_recupera" />

            </tree>
        </field>
    </record>

    <!-- Action Of Form & Tree Views Of School Information -->
    <record id="action_school_tipoeva_form" model="ir.actions.act_window">
        <field name="name">Tipos de Evaluación</field>
        <field name="res_model">school.tipoeva</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- MENU Of School Information -->
       <menuitem id="menu_school_tipoeva_sub_form" 
               name="Tipo evaluación" 
             parent="menu_school_config_eva" 
             action="action_school_tipoeva_form" /> 

</odoo>