<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <!-- Tree View Of Registro de Asistencia -->
    <record id="view_subject_evaluacion_tree" model="ir.ui.view">
        <field name="name">subject.evaluacion.tree</field>
        <field name="model">subject.evaluacion</field>
        <field name="arch" type="xml">
            <tree string="Información del Registro de Asistencia" create="0" delete="0">
               
                <field name="standard_id"/>
                <field name="subject_id"/>
                <field name="teacher_id"/>
                <field name="evaluacion_id"/>
                <field name="date_start"/>
                <field name="note"/>
 
                <field name="state_aux" decoration-warning="state_aux =='por iniciar'" 
                                    decoration-success="state_aux =='iniciado'"
                                    decoration-info="state_aux =='culminado'"
                                    widget="badge" optional="show"/>

            </tree>
        </field>
    </record>

    <!-- Form View Of Registro de Asistencias Information -->
    <record id="view_subject_evaluacion_form" model="ir.ui.view">
        <field name="name">subject.evaluacion.form</field>
        <field name="model">subject.evaluacion</field>
        <field name="arch" type="xml">
            <form string="Información Registro de Evaluaciones">
                <header>
                    <button class="btn-info" name="set_terminate" string="CERRAR EVALUACIÒN" type="object" confirm="Está seguro de CERRAR LA EVALUACIÓN ?"
                            icon="fa-lock" states="done" groups="school.group_school_administration,school.group_school_teacher"/>
                    <button class="btn-success" icon="fa-check"  name="set_done" type="object" confirm="Está seguro de INICIAR LA EVALUACIÓN ?"
                            string="INICIAR EVALUACIÒN" states="draft" groups="school.group_school_administration,school.group_school_teacher" />
                    <button class="btn-warning" icon="fa-search"  name="set_done_corregir" type="object" confirm="Está seguro de VOLVER A INICIADA LA EVALUACIÓN ?"
                                                string="VOLVER A INICIADO" states="terminate" groups="school.group_school_administration,school.group_school_teacher" />
                    <!-- <button class="btn-danger" icon="fa-ban" name="set_cancel" type="object" string="CANCELAR EVALUACIÒN" states="draft" groups="school.group_school_administration"/> -->
                    <field name="state" widget="statusbar" statusbar_visible="draft,cancel"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Por Iniciar" bg_color="bg-warning" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <widget name="web_ribbon" title="Iniciado"   bg_color="bg-success" attrs="{'invisible': [('state', '!=', 'done')]}"/>
                    <widget name="web_ribbon" title="Culminado"  bg_color="bg-info"  attrs="{'invisible': [('state', '!=', 'terminate')]}"/>
                    <widget name="web_ribbon" title="Cancelada"  bg_color="bg-danger"  attrs="{'invisible': [('state', '!=', 'cancel')]}"/>
                    
                    <newline />
                    <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                    </div>
                    
                    <separator string="Información de la Evaluaciòn" />
                    <group col="2">
                        <group string="Datos de la Secciòn">
                            <!-- <field name="id" readonly="1"/>  -->
                            <field name="evaluacion_id" widget="selection" readonly="1" placeholder="Evaluación"/>
                            <field name="standard_id" widget="selection" readonly="1" placeholder="Sección"/>
                            <field name="subject_id" widget="selection" readonly="1" placeholder="Curso"/>
                            <field name="teacher_id" widget="selection" placeholder="Profesor" readonly="1"/>
                            <field name="date_start" placeholder="Fecha"/>
                        </group>
                        <group string="Promedios">
                            <!-- <field name="id" readonly="1"/> -->
                            <field name="average_o" readonly="1" widget="integer"/>
                            <field name="average_e" readonly="1" widget="integer"/>
                            <field name="average_t" readonly="1" widget="integer"/>
                        </group>
                    </group>
                   <separator string="Observaciones" />
                    <group colspan="4">
                       <field name="note" colspan="2" placeholder="Observaciones" nolabel="1" widget="text"/>
                    </group>
                    
                    <notebook>
                        
                        <!-- <page string="Profesores">
                            <field name="teacher_ids" nolabel="1" colspan="4"
                                 options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                        </page>
                        <page string="Estudiantes" attrs="{'invisible':[('elective_id','!=',True)]}">
                            <field name="student_ids" nolabel="1" />
                        </page> -->

                        <!-- DESARROLLO PROPIO: SE AGREGO ESTE PAGE -->
                        <page string="ESTUDIANTES INSCRITOS">
                            <field name="evaluacion_ids" nolabel="1" colspan="4" editable="0" delete="0">
                                <tree string="Estudiantes" create="0" delete="0" editable="bottom">
                                    <!-- <field name="evaluacion_id" /> -->
                                    <!-- <field name="inscripcion_id" />
                                    <field name="evaluacion_id" /> -->
                                    <field name="student_id" readonly="1"/>
                                    
                                    <field name="eva_oral" attrs="{'readonly': ['|',('is_recupera', '=', True),('state', '!=', 'borrador')]}" widget="integer"/>
                                    <field name="eva_esc"  attrs="{'readonly': ['|',('is_recupera', '=', True),('state', '!=', 'borrador')]}" widget="integer"/>
                                    <field name="is_recupera" attrs="{'readonly': [('state', '!=', 'borrador')]}"/>
                                    <field name="rec_oral" attrs="{'readonly': ['|',('is_recupera', '=', False),('state', '!=', 'borrador')]}" widget="integer"/>
                                    <field name="rec_esc"  attrs="{'readonly': ['|',('is_recupera', '=', False),('state', '!=', 'borrador')]}" widget="integer"/>
                                    <field name="eva_total" readonly="1" widget="integer"/>
                                    <field name="state" decoration-warning="state =='borrador'" 
                                                        decoration-success="state =='aprobado'"
                                                        decoration-danger="state =='aplazado'"
                                                        decoration-info="state =='inasistente'"
                                                        widget="badge" optional="show"/>
                                    <field name="note" attrs="{'readonly': [('state', '!=', 'borrador')]}"/>
                                </tree>

                                <form string="Estudiantes">
                                    <group>
                                        <group>
                                            <field name="student_id" placeholder="Estudiante" readonly="1"/>
                                        </group>
                                        <group>
                                            <field name="eva_oral" placeholder="Escriba la Evaluación Oral"/>
                                        </group>
                                        <group>
                                            <field name="eva_esc" placeholder="Escriba la Evaluación Escrita"/>
                                        </group>
                                        <group>
                                            <field name="is_recupera" placeholder="Indique si es recuperaciòn"/>
                                        </group>
                                        <group>
                                            <field name="rec_oral" placeholder="Escriba la Evaluación Oral"/>
                                        </group>
                                        <group>
                                            <field name="rec_esc" placeholder="Escriba la Evaluación Escrita"/>
                                        </group>
                                        <group>
                                            <field name="eva_total" placeholder="Escriba la Evaluación Total" readonly="1"/>
                                        </group>
                                        <group>
                                            <field name="state" readonly="1"/>
                                        </group>
                                        <group>
                                            <field name="note" placeholder="Observación"/>
                                        </group>
                                     </group>
                                </form>


                            </field>
                        </page>
                        <!--  -->

                    </notebook>
                    
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View Of School Standard Information -->
    <record id="view_evaluacion_search" model="ir.ui.view">
        <field name="name">subject.evaluacion.search</field>
        <field name="model">subject.evaluacion</field>
        <field name="arch" type="xml">
            <search string="Información de Grupo">
                <group col="10" colspan="4">
                    <field name="standard_id"/>
                    <field name="teacher_id"/>
                    <field name="subject_id"/>
                    <field name="state"/>
                </group>
                <newline />
                <group expand="0" string="Group By..." colspan="12" col="10">
                    <filter name="seccion" string="Secciòn"  help="By Seccion" context="{'group_by':'standard_id'}" />
                    <filter name="subject" string="Curso"    help="By Subject" context="{'group_by':'subject_id'}" />
                    <filter name="teacher" string="Profesor" help="By Teacher" context="{'group_by':'teacher_id'}" />
                    <filter name="state"   string="Status"   help="By state"   context="{'group_by':'state'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Action Of Form & Tree Views Of Registro de Asistencias -->
    <record id="action_subject_evaluacion_form" model="ir.actions.act_window">
        <field name="name">Registro de Evaluaciones</field>
        <field name="res_model">subject.evaluacion</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_subject_evaluacion_form" name="Evaluaciones" parent="menu_evaluacion" action="action_subject_evaluacion_form" />


</odoo>