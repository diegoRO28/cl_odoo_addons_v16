<?xml version="1.0" encoding="utf-8"?>    
<odoo>    

    <!-- Form View Of School Information -->
    <record id="view_school_programa_form" model="ir.ui.view">
        <field name="name">school.programa.form</field>
        <field name="model">school.programa</field>
        <field name="arch" type="xml">
            <form string="programa Information">
                <sheet>
                    <separator string="Información del programa" />
                    <group col="4" colspan="4">
                        
                        <field name="name" string="Nombre" placeholder="programa" /> 
                        <field name="code" placeholder="Código" />
                        <field name="is_active"  widget="boolean_toggle" placeholder="Escriba si acepta recuperación"/>

                    </group>
                    
                    
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View Of School Information -->
    <record id="view_school_school_tree" model="ir.ui.view">
        <field name="name">school.programa.tree</field>
        <field name="model">school.programa</field>
        <field name="arch" type="xml">
            <tree string="programa Information">
                <!-- <field name="company_id" /> -->
                <field name="name" string="Nombre" />
                <field name="code" />
                <field name="is_active" />

            </tree>
        </field>
    </record>

    <!-- Action Of Form & Tree Views Of School Information -->
    <record id="action_school_programa_form" model="ir.actions.act_window">
        <field name="name">Programas</field>
        <field name="res_model">school.programa</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- MENU Of School Information -->
       <menuitem id="menu_school_programa_sub_form" 
               name="Programas" 
             parent="menu_school_config_form1" 
             action="action_school_programa_form" /> 

</odoo>