<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data noupdate="1">

        <!-- Sequences For student.code (Student Code) -->

        <record id="seq_student_code" model="ir.sequence">
            <field name="name">Student code</field>
            <field name="code">student.code</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequences For student.registration (Registration Code) -->

        <record id="seq_student_reg" model="ir.sequence">
            <field name="name">Student registration code</field>
            <field name="code">student.registration</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequences For student.student (Personal Identification Number) -->

        <record id="seq_student_student" model="ir.sequence">
            <field name="name">Student</field>
            <field name="code">student.student</field>
            <field name="prefix">%(year)s/%(month)s/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>

        </record>

        <!-- Sequences For student.document (Student Documents) -->

        <record id="seq_student_document" model="ir.sequence">
            <field name="name">Document</field>
            <field name="code">student.document</field>
            <field name="prefix">F</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequences For document.type (Document Type) -->

        <record id="seq_student_sequence" model="ir.sequence">
            <field name="name">sequence</field>
            <field name="code">document.type</field>
            <field name="padding">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequences For student.code (Student Code) -->
        <record id="seq_inscripcion_code" model="ir.sequence">
            <field name="name">Inscripcion code</field>
            <field name="code">inscripcion.code</field>
            <field name="prefix">RI</field>
            <field name="padding">5</field>
            <field name="company_id" eval="True"/>
        </record>

        <!-- Sequences For student.code (Student Code) -->
        <record id="seq_retiro_code" model="ir.sequence">
            <field name="name">Retiro code</field>
            <field name="code">retiro.code</field>
            <field name="prefix">RR</field>
            <field name="padding">4</field>
            <field name="company_id" eval="True"/>
        </record>

        <!-- Sequences For cambio.code (Cambio Code) -->
        <record id="seq_cambio_code" model="ir.sequence">
            <field name="name">Cambio Code</field>
            <field name="code">cambio.code</field>
            <field name="prefix">RC</field>
            <field name="padding">4</field>
            <field name="company_id" eval="True"/>
        </record>

        <!-- Sequences For student.code (Student Code) -->
        <record id="seq_seccion_code" model="ir.sequence">
            <field name="name">Seccion code</field>
            <field name="code">seccion.code</field>
            <field name="prefix">SEC</field>
            <field name="padding">5</field>
            <field name="company_id" eval="True"/>
        </record>

        <!-- Sequences For student.code (Student Code) -->
        <record id="seq_evaluacion_code" model="ir.sequence">
            <field name="name">Evaluacion Code</field>
            <field name="code">evaluacion.code</field>
            <field name="prefix">RE</field>
            <field name="padding">6</field>
            <field name="company_id" eval="True"/>
        </record>

        <!-- Sequences For student.code (Student Code) -->
        <record id="seq_asistencia_code" model="ir.sequence">
            <field name="name">Asistencia Code</field>
            <field name="code">asistencia.code</field>
            <field name="prefix">RA</field>
            <field name="padding">6</field>
            <field name="company_id" eval="True"/>
        </record>

        <!-- Sequences For student.code (Student Code) -->
        <record id="seq_curso_code" model="ir.sequence">
            <field name="name">Curso Code</field>
            <field name="code">curso.code</field>
            <field name="prefix">CUR</field>
            <field name="padding">3</field>
            <field name="company_id" eval="True"/>
        </record>


        <!-- Sequences For LIBROEVA.code (V2) -->
        <record id="seq_libroeva_code" model="ir.sequence">
            <field name="name">Libroeva code</field>
            <field name="code">libroeva.code</field>
            <field name="prefix">LIBE</field>
            <field name="padding">2</field>
            <field name="company_id" eval="True"/>
        </record>

        <!-- Sequences For LIBROEVAS.code (V2) -->
        <record id="seq_libroevas_code" model="ir.sequence">
            <field name="name">Libroevas code</field>
            <field name="code">libroevas.code</field>
            <field name="prefix">EVA</field>
            <field name="padding">3</field>
            <field name="company_id" eval="True"/>
        </record>

        <!-- Sequences For LIBROEVAS.code (V2) -->
        <record id="seq_libroact_code" model="ir.sequence">
            <field name="name">Libroact code</field>
            <field name="code">libroact.code</field>
            <field name="prefix">ACT</field>
            <field name="padding">4</field>
            <field name="company_id" eval="True"/>
        </record>

        <!-- Sequences For LIBROEVAS.code (V2) -->
        <record id="seq_standard_evaluacion_code" model="ir.sequence">
            <field name="name">Libro Evaluaciones code</field>
            <field name="code">registroeva.code</field>
            <field name="prefix">EVA</field>
            <field name="padding">3</field>
            <field name="company_id" eval="True"/>
        </record>

    </data>
</odoo>
