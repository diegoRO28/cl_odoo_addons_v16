<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quick_create_opportunity_school_form_inherit" model="ir.ui.view">
        <field name="name">quick.create.opportunity.school.form.inherited</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.quick_create_opportunity_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="is_company_partner" />
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('is_company', '=', is_company_partner)]</attribute>
                <attribute name="context">
                {
                    'res_partner_search_mode': type == 'opportunity' and 'customer' or False,
                    'default_name': contact_name or partner_name,
                    'default_is_company': is_company_partner,
                    'default_company_name': type == 'opportunity' and partner_name,
                    'default_phone': phone,
                    'default_email': email_from,
                    'default_user_id': user_id,
                    'default_team_id': team_id,
                    'show_vat': True
                }
                </attribute>
            </xpath>            
        </field>
    </record>

    <record id="crm_lead_school_view_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.school.view.form.inherited</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button 
                    name="action_create_student" 
                    string="Crear Registro de Estudiante" 
                    type="object" 
                    class="oe_highlight"  
                    attrs="{'invisible': ['|', ('is_won', '=', False), ('student_id', '!=', False)]}"
                    groups="school_crm.group_create_student_from_crm"
                />
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_won" invisible="1" />
                <field name="student_id" readonly="1" />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="student" string="Registro de estudiante" groups="school_crm.group_create_student_from_crm">
                    <group>
                        <group>
                            <field name="student_id" attrs="{'invisible': [('student_id', '=', False)]}" readonly="1" />
                            <field name="student_code" attrs="{'invisible': [('student_id', '!=', False)]}" />
                            <field name="student_ci" attrs="{'invisible': [('student_id', '!=', False)]}"/>
                            <field 
                                name="school_parent_ids" 
                                attrs="{'invisible': [('student_id', '!=', False)]}" 
                                context="{'form_view_ref': 'school_optimize.view_school_parent_optimize_form', 'default_parent_school':1}" 
                                options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"
                                widget="many2many_tags"
                            />
                            <!-- =============== Campos relacionados =============== -->
                            <field name="student_code_related" attrs="{'invisible': [('student_id', '=', False)]}" />
                            <field name="student_ci_related" attrs="{'invisible': [('student_id', '=', False)]}" />
                        </group>
                        <group>
                            <field name="school_id" options="{'no_create': True, 'no_edit': True, 'no_quick_create': True, 'no_create_edit': True}" attrs="{'invisible': [('student_id', '!=', False)]}"/>
                            <field name="gender" attrs="{'invisible': [('student_id', '!=', False)]}"/>
                            <!-- =============== Campos relacionados =============== -->
                            <field name="school_id_related" attrs="{'invisible': [('student_id', '=', False)]}" />
                            <field name="gender_related" attrs="{'invisible': [('student_id', '=', False)]}" />
                            <field 
                                name="school_parent_ids_related" 
                                attrs="{'invisible': [('student_id', '=', False)]}" 
                                widget="many2many_tags"
                            />                            
                        </group>
                    </group>                    
                </page>
            </xpath>                        
        </field>
    </record>   

    <record id="view_crm_case_opportunities_filter_student_inherit" model="ir.ui.view">
        <field name="name">view.crm.case.opportunities.filter.student.inherited</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="after">
                <separator />
                <filter string="Oportunidades para Estudiantes"
                        name="student_opportunities"
                        domain="[('student_id', '!=', False)]"
                        help="Filtr de Oportunidades para Estudiantes"/>                
            </xpath>
        </field>
    </record>     
</odoo>