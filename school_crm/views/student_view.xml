<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_student_student_form_1_inherit" model="ir.ui.view">
        <field name="name">student.student.form.1.inherited</field>
        <field name="model">student.student</field>
        <field name="inherit_id" ref="school.view_student_student_form_1"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="CRM" attrs="{'invisible': [('opportunity_id', '=', False)]}">
                    <group>
                        <group>
                            <field name="opportunity_id" readonly="1"/>
                        </group>
                        <group />
                    </group>
                </page>                  
            </xpath>
        </field>
    </record>

    <record id="view_student_student_crm_inherit_search_1" model="ir.ui.view">
        <field name="name">view.student.student.crm.inherited.search.1</field>
        <field name="model">student.student</field>
        <field name="inherit_id" ref="school.view_student_student_search_1"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='school_id']" position="after">
                <separator />
                <filter string="Registrados desde CRM"
                        name="added_from_crm"
                        domain="[('opportunity_id', '!=', False)]"
                        help="Estudiantes registrados desde CRM"/>                
            </xpath>
        </field>
    </record>
</odoo>