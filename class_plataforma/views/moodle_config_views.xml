<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_moodle_config_form" model="ir.ui.view">
        <field name="name">moodle.config.form</field>
        <field name="model">moodle.config</field>
        <field name="arch" type="xml">
            <form string="Configuración Moodle">
                <header>
                    <button name="action_test_connection" type="object"
                            string="Probar conexión" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="name"/>
                            <field name="url"/>
                            <field name="token" password="True"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="default_password" password="True"/>
                            <field name="default_city"/>
                            <field name="default_country"/>
                            <field name="enrol_role_id"/>
                            <field name="timeout"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_moodle_config_tree" model="ir.ui.view">
        <field name="name">moodle.config.tree</field>
        <field name="model">moodle.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="company_id"/>
                <field name="url"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="action_moodle_config" model="ir.actions.act_window">
        <field name="name">Configuración Moodle</field>
        <field name="res_model">moodle.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Regla multiempresa: cada usuario ve solo las configuraciones de las
         empresas que tiene seleccionadas en el selector de empresas. Así el
         token de un aula virtual no queda a la vista al trabajar con otra
         empresa. (company_ids lo provee Odoo en el contexto de la regla.) -->
    <record id="moodle_config_company_rule" model="ir.rule">
        <field name="name">Configuración de Plataforma: por empresa</field>
        <field name="model_id" ref="model_moodle_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <menuitem id="menu_plataforma_root" name="Plataforma"
              parent="school.menu_ems" sequence="15"
              groups="school.group_school_administration"/>
    <!-- "Configuración" es ahora un contenedor (sin acción propia): en
         Odoo 16 un menú con hijos se despliega y su acción no se alcanza.
         El formulario de conexión pasa a su hijo "Conexión"; los logs
         (sync_log_menus.xml) cuelgan de este mismo contenedor.
         Se define como <record> (y no <menuitem>) para poder limpiar
         explícitamente la acción que el menú ya tenía guardada en la base
         de datos: un <menuitem> sin 'action' no la borra. -->
    <record id="menu_moodle_config" model="ir.ui.menu">
        <field name="name">Configuración</field>
        <field name="parent_id" ref="menu_plataforma_root"/>
        <field name="sequence">10</field>
        <field name="action" eval="False"/>
        <field name="groups_id" eval="[(6, 0, [ref('school.group_school_administration')])]"/>
    </record>
    <menuitem id="menu_moodle_config_conexion" name="Conexión"
              parent="menu_moodle_config"
              action="action_moodle_config" sequence="10"
              groups="school.group_school_administration"/>

</odoo>
