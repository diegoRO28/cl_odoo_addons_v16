<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Vistas de los 4 logs de sincronización (todas sobre el mismo
         modelo moodle.sync.log). Cada categoría tiene SU PROPIA vista de
         lista, formulario y búsqueda: solo muestra el/los campo(s)
         Many2one que le corresponden (inscripcion_id/retiro_id/cambio_id
         para Administración, student_id para Estudiante, standard_id
         para Secciones, evaluacion_id para Evaluaciones), para no mezclar
         columnas vacías de otras categorías. El detalle (mensaje, datos
         enviados y respuesta de la Plataforma) se muestra completo en
         todas: estas vistas son para uso técnico/administrativo.

         Los MENÚS de estos logs viven en sync_log_menus.xml (bajo
         Plataforma > Configuración): aquí solo van vistas y acciones.
    ================================================================= -->

    <!-- ================================================================
         Log 1 de 4: Administración (Inscripciones, Retiros y Cambios)
    ================================================================= -->
    <record id="view_moodle_sync_log_tree_administracion" model="ir.ui.view">
        <field name="name">moodle.sync.log.tree.administracion</field>
        <field name="model">moodle.sync.log</field>
        <field name="arch" type="xml">
            <tree decoration-danger="status == 'error'"
                  decoration-success="status == 'success'" create="false">
                <field name="create_date"/>
                <field name="name" string="Operación"/>
                <field name="student_code" string="Estudiante"/>
                <field name="inscripcion_id"/>
                <field name="retiro_id"/>
                <field name="cambio_id"/>
                <field name="status"/>
                <field name="message" string="Detalle"/>
            </tree>
        </field>
    </record>

    <record id="view_moodle_sync_log_form_administracion" model="ir.ui.view">
        <field name="name">moodle.sync.log.form.administracion</field>
        <field name="model">moodle.sync.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <field name="name" string="Operación"/>
                        <field name="status"/>
                        <field name="create_date"/>
                        <field name="student_code"/>
                        <field name="inscripcion_id"/>
                        <field name="retiro_id"/>
                        <field name="cambio_id"/>
                    </group>
                    <group>
                        <field name="message"/>
                        <field name="request_data"/>
                        <field name="response_data"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_moodle_sync_log_search_administracion" model="ir.ui.view">
        <field name="name">moodle.sync.log.search.administracion</field>
        <field name="model">moodle.sync.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_code" string="Estudiante (código)"/>
                <field name="inscripcion_id"/>
                <field name="retiro_id"/>
                <field name="cambio_id"/>
                <field name="name" string="Operación"/>
                <separator/>
                <filter name="filter_error" string="Con error" domain="[('status', '=', 'error')]"/>
                <filter name="filter_success" string="Exitosos" domain="[('status', '=', 'success')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_estudiante_codigo" string="Estudiante (código)" context="{'group_by': 'student_code'}"/>
                    <filter name="group_operacion" string="Operación" context="{'group_by': 'name'}"/>
                    <filter name="group_estado" string="Estado" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_moodle_sync_log_administracion" model="ir.actions.act_window">
        <field name="name">Log (Administración)</field>
        <field name="res_model">moodle.sync.log</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">['|', '|', ('inscripcion_id', '!=', False), ('retiro_id', '!=', False), ('cambio_id', '!=', False)]</field>
        <field name="search_view_id" ref="view_moodle_sync_log_search_administracion"/>
        <field name="context">{'search_default_group_estudiante_codigo': 1}</field>
    </record>
    <record id="action_moodle_sync_log_administracion_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_moodle_sync_log_tree_administracion"/>
        <field name="act_window_id" ref="action_moodle_sync_log_administracion"/>
    </record>
    <record id="action_moodle_sync_log_administracion_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_moodle_sync_log_form_administracion"/>
        <field name="act_window_id" ref="action_moodle_sync_log_administracion"/>
    </record>

