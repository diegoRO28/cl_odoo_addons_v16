<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_moodle_sync_log_tree" model="ir.ui.view">
        <field name="name">moodle.sync.log.tree</field>
        <field name="model">moodle.sync.log</field>
        <field name="arch" type="xml">
            <tree decoration-danger="status == 'error'"
                  decoration-success="status == 'success'" create="false">
                <field name="create_date"/>
                <field name="name"/>
                <field name="student_code"/>
                <field name="inscripcion_id"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_moodle_sync_log_form" model="ir.ui.view">
        <field name="name">moodle.sync.log.form</field>
        <field name="model">moodle.sync.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="status"/>
                        <field name="inscripcion_id"/>
                        <field name="student_code"/>
                        <field name="create_date"/>
                    </group>
                    <group>
                        <field name="message"/>
                        <field name="request_data"/>
                        <field name="response_data"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_moodle_sync_log" model="ir.actions.act_window">
        <field name="name">Log de Sincronización</field>
        <field name="res_model">moodle.sync.log</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_moodle_sync_log" name="Log de Sincronización"
              parent="menu_plataforma_root"
              action="action_moodle_sync_log" sequence="20"
              groups="school.group_school_administration"/>

</odoo>
